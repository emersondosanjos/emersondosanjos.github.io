---
/* "EBA" hand-lettered, cut out as a vinyl sticker: white die-cut rim, navy keyline, yellow pen stroke. */
---
<svg class="eba-logo" viewBox="-6 -4 124 72" aria-hidden="true">
  <defs><g id="eba-strokes"><path d="M15 13 C 12 23, 13.5 35, 13 48.5" /><path d="M14 12.5 C 20 10.5, 25 12, 30.5 9" /><path d="M13.5 30.5 C 18 29, 21.5 31, 26 28.5" /><path d="M13 48.5 C 20 50, 25.5 47, 32 48.5" /><path d="M41 10.5 C 42.5 22, 39.5 37, 41.5 50" /><path d="M40.5 11 C 56 5.5, 59 25.5, 42 28.5" /><path d="M42 28 C 63 25.5, 62 53.5, 41.5 50.5" /><path d="M62.5 51 C 66 37, 71.5 20.5, 76.5 8.5 C 80.5 22, 85 37.5, 92 51.5" /><path d="M66.5 37 C 73 34.5, 79 37.5, 87 33.5" /><path d="M9 57 C 38 52.5, 70 59.5, 104 50.5" /></g></defs>
  <g class="rim"><use href="#eba-strokes" /></g>
  <g class="cut"><use href="#eba-strokes" /></g>
  <g class="key"><use href="#eba-strokes" /></g>
  <g class="ink"><use href="#eba-strokes" /></g>
</svg>

<style>
  .eba-logo {
    display: block; flex: none; width: 50px; height: auto; overflow: visible;
    transform: rotate(-7deg);
    filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.35));
    transition: transform 0.3s var(--ease-out);
  }
  .eba-logo g { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .rim { stroke: var(--logo-rim, #fff); stroke-width: 19.5; }
  .cut { stroke: #fff; stroke-width: 16; }
  .key { stroke: #0b2d6b; stroke-width: 8.6; }
  .ink { stroke: var(--signal); stroke-width: 5; }
  :global(a.mark:hover) .eba-logo { transform: rotate(-2deg) translateY(-1px) scale(1.04); }
  @media (max-width: 480px) { .eba-logo { width: 42px; } }
</style>

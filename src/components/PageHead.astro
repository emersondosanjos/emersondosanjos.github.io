---
interface Props {
  title: string;
  lede: string;
  hasAside?: boolean;
}
const { title, lede, hasAside = false } = Astro.props;
---
<section class="ph on-dark">
  <div class:list={['wrap', { 'ph-split': hasAside }]}>
    <div>
      <h1>{title}</h1>
      <p>{lede}</p>
      <slot />
    </div>
    {hasAside && (
      <div class="ph-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .ph { padding-block: clamp(48px, 8vw, 104px) clamp(36px, 5vw, 64px); border-bottom: 1px solid var(--plate-rule); }
  .ph-split { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px 56px; align-items: center; }
  h1 { font: 400 clamp(2.8rem, 7vw, 5.4rem)/0.95 var(--hand); letter-spacing: -0.025em; color: var(--mist); }
  p { max-width: var(--measure); font-size: 1.15rem; color: var(--mist-soft); margin: 18px 0 0; }
  @media (max-width: 820px) {
    .ph-split { grid-template-columns: 1fr; }
  }
</style>

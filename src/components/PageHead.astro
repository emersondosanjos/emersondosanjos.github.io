---
interface Props {
  title: string;
  lede: string;
  hasAside?: boolean;
}
const { title, lede, hasAside = false } = Astro.props;
---
<section class="ph on-dark">
  <div class:list={['wrap', { 'ph-split': hasAside }]}>
    <div>
      <h1>{title}</h1>
      <p>{lede}</p>
      <slot />
    </div>
    {hasAside && (
      <div class="ph-aside">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .ph { padding-block: clamp(24px, 4.5vw, 56px) clamp(24px, 3.5vw, 44px); border-bottom: 1px solid var(--plate-rule); }
  .ph-split { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 28px 56px; align-items: center; }
  h1 { font: 600 clamp(2.25rem, 7vw, 5.4rem)/1.05 var(--sans); letter-spacing: -0.035em; color: var(--mist); }
  p { max-width: var(--measure); font-size: clamp(1rem, 1.5vw, 1.15rem); color: var(--mist-soft); margin: 14px 0 0; }
  @media (max-width: 820px) {
    .ph-split { grid-template-columns: 1fr; }
  }
</style>

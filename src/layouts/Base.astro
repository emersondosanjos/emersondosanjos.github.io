---
import '../styles/global.css';
import { SERIES, SERIES_ORDER, nmToPct, links, emails } from '../lib/works';
import { UI, localePath, counterpartPath, type Lang } from '../lib/i18n';
import Icon from '../components/Icon.astro';
import ProfileLogo from '../components/ProfileLogo.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  lang?: Lang;
}

const { title, description, current = '/', lang = 'en' } = Astro.props;
const t = UI[lang];
const contentLicense = lang === 'pt'
  ? 'https://creativecommons.org/licenses/by-nc/4.0/deed.pt-br'
  : 'https://creativecommons.org/licenses/by-nc/4.0/';
const mainNav = [...t.nav, t.navTeach];
const featured = [t.navFeature, t.navFeature2];
const desc = description ?? t.siteDescriptionDefault;
const pageTitle = title ? `${title} · Emerson Barbosa dos Anjos` : t.siteTitleDefault;

const enUrl = new URL(counterpartPath(current, 'en'), Astro.site);
const ptUrl = new URL(counterpartPath(current, 'pt'), Astro.site);
const canonicalUrl = new URL(localePath(current, lang), Astro.site);
const year = new Date().getFullYear();
const [primaryEmail, ...extraEmails] = emails;
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'} data-theme="white">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#dbe7f6" />
    <link rel="icon" href="/favicon-eba.svg?v=4" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=4" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <link rel="shortcut icon" href="/favicon-32.png?v=4" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skipToContent}</a>
    <header class="top">
      <div class="ruler" aria-hidden="true">
        {SERIES_ORDER.map((id) => (
          <i data-line={id} style={`left:${nmToPct(SERIES[id].nm)}%`}></i>
        ))}
      </div>
      <div class="wrap bar">
        <a class="mark" href={localePath('/', lang)} aria-label="Emerson Barbosa dos Anjos">
          <span class="brand-name"><span class="given-name">Emerson Barbosa</span> <span class="name-highlight">dos Anjos</span></span>
        </a>
        <div class="nav-cluster">
          <nav class="main-nav" aria-label={t.navLabel}>
            <ul>
              {mainNav.map(({ href, label }) => (
                <li><a href={localePath(href, lang)} aria-current={current === href ? 'page' : undefined}>{href === t.navTeach.href && <Icon name="lock" />}{label}</a></li>
              ))}
            </ul>
          </nav>
          <nav class="featured-nav" aria-label={t.navFeaturedLabel}>
            {featured.map(({ href, label }, index) => (
              <a class:list={['nav-feature', { alt: index === 1 }]} href={localePath(href, lang)} aria-current={current === href ? 'page' : undefined}>{label}</a>
            ))}
          </nav>
          <div class="lang-switch" role="group" aria-label={t.langLabel}>
            <a
              href={counterpartPath(current, 'en')}
              hreflang="en"
              aria-current={lang === 'en' ? 'true' : undefined}
              title="English"
            >
              <svg class="flag" viewBox="0 0 18 12" aria-hidden="true">
                <rect width="18" height="12" rx="1.5" fill="#b22234" />
                <path d="M0 2.5h18M0 5.5h18M0 8.5h18M0 11h18" stroke="#fff" stroke-width="1.2" />
                <rect width="8.5" height="6.5" rx="0.5" fill="#3c3b6e" />
                <circle cx="2.2" cy="1.8" r="0.6" fill="#fff" />
                <circle cx="4.3" cy="1.8" r="0.6" fill="#fff" />
                <circle cx="6.4" cy="1.8" r="0.6" fill="#fff" />
                <circle cx="3.2" cy="3.4" r="0.6" fill="#fff" />
                <circle cx="5.4" cy="3.4" r="0.6" fill="#fff" />
                <circle cx="2.2" cy="4.9" r="0.6" fill="#fff" />
                <circle cx="4.3" cy="4.9" r="0.6" fill="#fff" />
                <circle cx="6.4" cy="4.9" r="0.6" fill="#fff" />
              </svg>
              <span>EN</span>
            </a>
            <a
              href={counterpartPath(current, 'pt')}
              hreflang="pt-BR"
              aria-current={lang === 'pt' ? 'true' : undefined}
              title="Português"
            >
              <svg class="flag" viewBox="0 0 18 12" aria-hidden="true">
                <rect width="18" height="12" rx="1.5" fill="#009c3b" />
                <polygon points="9,1.4 16.4,6 9,10.6 1.6,6" fill="#ffdf00" />
                <circle cx="9" cy="6" r="2.6" fill="#002776" />
                <path d="M6.6 5.8a4.2 4.2 0 0 1 4.8.6" fill="none" stroke="#fff" stroke-width="0.65" />
              </svg>
              <span>PT</span>
            </a>
          </div>
          <button class="nav-toggle" type="button" data-nav-toggle aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            <span class="toggle-menu">{t.navMenuLabel}</span>
            <span class="toggle-featured">{t.navFeaturedLabel}</span>
          </button>
        </div>
      </div>
    </header>

    <dialog id="site-menu" class="site-menu" aria-labelledby="site-menu-heading">
      <div class="menu-heading">
        <h2 id="site-menu-heading"><span class="toggle-menu">{t.navMenuLabel}</span><span class="toggle-featured">{t.navFeaturedLabel}</span></h2>
        <form method="dialog">
          <button class="menu-close" aria-label={t.navCloseLabel} autofocus>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </button>
        </form>
      </div>
      <nav class="menu-main" aria-label={t.navLabel}>
        {t.nav.map(({ href, label }) => (
          <a href={localePath(href, lang)} aria-current={current === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <nav class="menu-featured" aria-label={t.navFeaturedLabel}>
        <h3>{t.navFeaturedLabel}</h3>
        {featured.map(({ href, label }, index) => (
          <a class:list={['nav-feature', { alt: index === 1 }]} href={localePath(href, lang)} aria-current={current === href ? 'page' : undefined}>{label}<Icon name="arrow" /></a>
        ))}
        <a class="nav-feature teaching-feature" href={localePath(t.navTeach.href, lang)} aria-current={current === t.navTeach.href ? 'page' : undefined}>
          <span><Icon name="lock" />{t.navTeach.label}</span><Icon name="arrow" />
        </a>
      </nav>
    </dialog>

    <main id="main"><slot /></main>

    <footer class="foot on-dark">
      <div class="wrap foot-grid">
        <div>
          <p class="foot-heading">{t.footer.heading}</p>
          <p class="foot-note">{t.footer.note}</p>
          <div class="foot-emails">
            {primaryEmail && (
              <a class="act solid" href={`mailto:${primaryEmail}`}>
                <Icon name="mail" /> <span>{primaryEmail}</span>
              </a>
            )}
            {extraEmails.map((email) => (
              <a class="act ghost foot-mail-sec" href={`mailto:${email}`}>
                <Icon name="mail" /> <span>{email}</span>
              </a>
            ))}
          </div>
        </div>
        <ul class="foot-links">
          <li><a href={links.orcid}><span class="fl-name"><ProfileLogo name="orcid" />ORCID</span> <span class="mono">0000-0002-9401-5099</span></a></li>
          <li><a href={links.lattes}><span class="fl-name"><ProfileLogo name="lattes" />Lattes CV</span> <span class="mono">3753408008148421</span></a></li>
          <li><a href={links.linkedin}><span class="fl-name"><ProfileLogo name="linkedin" />LinkedIn</span> <span class="sub">emerson-barbosa</span></a></li>
          <li><a href={links.github}><span class="fl-name"><ProfileLogo name="github" />GitHub</span> <span class="sub">emersondosanjos</span></a></li>
          <li><a href={links.zenodo}><span class="fl-name"><ProfileLogo name="zenodo" />Zenodo</span> <span class="sub">{t.footer.zenodoSub}</span></a></li>
        </ul>
        <p class="foot-legal">© {year} Emerson Barbosa dos Anjos · {t.footer.location} · {t.footer.licenseLabel} <a rel="license" href={contentLicense}>CC BY-NC 4.0</a> · {t.footer.legal}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
    });

    menu.addEventListener('close', () => toggle.setAttribute('aria-expanded', 'false'));
    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) {
        menu.close();
      } else if (target === menu) {
        const bounds = menu.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right) menu.close();
      }
    });

    matchMedia('(max-width: 1280px)').addEventListener('change', (event) => {
      if (!event.matches && menu.open) menu.close();
    });
  }
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--plate-rule);
  }
  .ruler {
    position: relative;
    height: 8px;
    background-color: var(--plate);
    background-image:
      repeating-linear-gradient(90deg, var(--plate-rule) 0 1px, transparent 1px 12px),
      repeating-linear-gradient(90deg, var(--mist-soft) 0 1px, transparent 1px 120px);
    background-size: 100% 4px, 100% 7px;
    background-repeat: no-repeat;
    background-position: left bottom;
  }
  .ruler i { position: absolute; top: 0; bottom: 0; width: 3px; background: var(--c); transform: translateX(-50%); }

  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 54px; }
  .mark { display: inline-flex; align-items: center; font: 600 1.03rem/1.15 var(--sans); text-decoration: none; color: var(--mist); }
  .given-name { white-space: nowrap; }
  .mark .name-highlight { text-shadow: var(--name-outline-sm, none); }

  .nav-cluster, .main-nav ul, .featured-nav { display: flex; align-items: center; }
  .nav-cluster { gap: 18px; }
  .main-nav ul { gap: 14px; list-style: none; margin: 0; padding: 0; }
  .main-nav a {
    display: flex;
    align-items: center;
    min-height: 36px;
    gap: 5px;
    font: 500 0.89rem/1.2 var(--sans);
    text-decoration: none;
    color: var(--mist-soft);
    white-space: nowrap;
  }
  .main-nav a :global(svg) { width: 0.95em; height: 0.95em; flex: none; }
  .main-nav a:hover, .main-nav a[aria-current='page'] { color: var(--mist); }
  .main-nav a[aria-current='page'] { text-decoration: underline 2px; text-underline-offset: 0.42em; }
  .featured-nav { gap: 8px; }
  /* feature button: marker-on-paper, hand-cut edges, a strip of tape on the corner */
  .nav-feature {
    --tilt: 1.5deg;
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    font: 700 0.86rem/1 var(--sans);
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
    color: var(--signal-ink);
    background: var(--signal);
    border: 2.5px solid var(--shadow-ink);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 0.55rem 0.8rem 0.5rem;
    transform: rotate(var(--tilt));
    box-shadow: 0 10px 16px -9px rgba(0, 0, 0, 0.75), 0 2px 0 rgba(4, 10, 36, 0.35);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  .nav-feature::before {
    content: '';
    position: absolute;
    top: -0.62rem;
    right: -0.9rem;
    width: 2.9rem;
    height: 1.05rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.25) 45%, rgba(214, 220, 232, 0.4));
    transform: rotate(28deg);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    -webkit-mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
    mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
  }
  .nav-feature.alt { --tilt: -1.5deg; background: var(--name-highlight, #fff); color: var(--ink); margin-left: -6px; }
  .nav-feature.alt::before { left: -0.8rem; right: auto; transform: rotate(-24deg); }
  .nav-feature:hover { transform: rotate(calc(var(--tilt) * -1)) translateY(-2px); box-shadow: 0 16px 22px -12px rgba(0, 0, 0, 0.8), 0 2px 0 rgba(4, 10, 36, 0.35); }
  .nav-feature:active { transform: rotate(0) translateY(1px); box-shadow: 0 4px 8px -6px rgba(0, 0, 0, 0.8); }
  .nav-feature[aria-current='page'] { transform: rotate(0); }

  .nav-toggle, .menu-close {
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 5px;
    padding-inline: 8px;
    border: 1px solid var(--plate-rule);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font: 600 0.83rem/1 var(--sans);
    cursor: pointer;
  }
  .nav-toggle, .toggle-menu { display: none; }
  .nav-toggle svg, .menu-close svg, .site-menu a :global(svg) {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    flex: none;
  }
  .site-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 22rem);
    height: 100%;
    max-width: 100%;
    max-height: none;
    margin: 0;
    padding: 18px clamp(16px, 4vw, 24px);
    padding-bottom: max(18px, env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .site-menu::backdrop { background: rgb(6 16 61 / 42%); }
  :global(html:has(.site-menu[open])) { overflow: hidden; }
  .menu-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
  .menu-heading h2 { font-size: 1.45rem; }
  .menu-close { display: inline-flex; min-width: 44px; }
  .menu-main, .menu-featured { display: grid; }
  .menu-featured h3 { display: none; }
  .menu-main a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .menu-main a:hover, .menu-main a[aria-current='page'] { background: var(--paper-2); text-decoration: underline; }
  .menu-featured { gap: 12px; padding-inline: 4px; }
  .menu-featured .nav-feature { margin-inline: 0; min-height: 44px; justify-content: space-between; gap: 10px; }
  .menu-featured .teaching-feature { display: none; --tilt: 0.7deg; background: var(--plate); color: var(--ink); border-color: var(--ink); }
  .menu-featured .teaching-feature > span { display: inline-flex; align-items: center; gap: 8px; }
  .menu-featured .teaching-feature[aria-current='page'] { background: var(--paper); box-shadow: 0 0 0 2px var(--signal); }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 9px;
    background: var(--plate);
    border: 1.5px solid var(--plate-rule);
    flex-shrink: 0;
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font: 600 0.82rem/1 var(--sans);
    text-decoration: none;
    color: var(--mist-soft);
    padding: 5px 8px;
    border-radius: 6px;
    transition: background-color 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }
  .lang-switch a:hover { color: var(--mist); }
  .lang-switch a[aria-current='true'] {
    background: var(--signal);
    color: var(--signal-ink);
  }
  .flag { width: 17px; height: 11px; flex: none; display: block; border-radius: 2px; }

  @media (max-width: 1280px) {
    .featured-nav, .menu-main { display: none; }
    .nav-toggle { display: inline-flex; }
  }
  @media (max-width: 960px) {
    .bar { gap: 8px; padding-block: 4px; }
    .mark { margin-right: auto; min-width: 0; font-size: 0.94rem; }
    .nav-cluster { gap: 8px; }
    .menu-featured .teaching-feature { display: inline-flex; }
    .nav-toggle { flex: none; }
    .main-nav, .toggle-featured { display: none; }
    .menu-main { display: grid; }
    .toggle-menu { display: inline; }
    .menu-featured { margin-top: 20px; }
    .menu-featured h3 { display: block; margin-bottom: 4px; font-size: 1rem; }
    .lang-switch { gap: 0; padding: 0; }
    .lang-switch a { min-height: 44px; padding: 4px 6px; }
    .lang-switch .flag { width: 16px; height: auto; }
  }
  @media (max-width: 420px) {
    .bar { gap: 6px; }
    .mark { font-size: 0.86rem; }
    .brand-name .given-name { display: block; }
    .lang-switch a { gap: 3px; padding-inline: 5px; }
    .nav-toggle { min-width: 44px; }
  }
  @media (max-width: 360px) {
    .nav-toggle .toggle-menu { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }

  .foot { background: var(--plate); border-top: 1px solid var(--plate-rule); padding-block: clamp(56px, 8vw, 96px) 32px; }
  .foot-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px 64px; }
  .foot-heading { font: 500 clamp(2.4rem, 5vw, 4rem)/1 var(--sans); color: var(--mist); margin: 0 0 16px; }
  .foot-note { color: var(--mist-soft); max-width: 48ch; margin: 0 0 24px; }
  .foot-emails { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .foot-emails .act { max-width: 100%; line-height: 1.25; overflow-wrap: anywhere; }
  .foot-mail-sec { font-size: 0.9rem; padding: 0.65em 0.95em; }
  .foot-links { list-style: none; margin: 0; padding: 0; align-self: end; }
  .foot-links li { border-top: 1px solid var(--plate-rule); }
  .foot-links li:last-child { border-bottom: 1px solid var(--plate-rule); }
  .foot-links a { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; text-decoration: none; font: 500 1.15rem/1.2 var(--sans); }
  .foot-links a:hover { color: var(--accent); }
  .fl-name { display: inline-flex; align-items: center; gap: 12px; }
  .foot-links .mono, .foot-links .sub { color: var(--mist-soft); align-self: center; }
  .foot-links .sub { font: 400 0.92rem/1 var(--sans); }
  .foot-legal { grid-column: 1 / -1; margin: 16px 0 0; color: var(--mist-soft); opacity: 0.85; }
  @media (max-width: 820px) {
    .foot-grid { grid-template-columns: 1fr; }
    .act.solid, .foot-mail-sec { font-size: 0.86rem; }
  }
</style>

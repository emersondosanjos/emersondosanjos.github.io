---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { UI } from '../lib/i18n';
const t = UI.en.notFound;
---
<Base title="Not found" current="/" lang="en">
  <PageHead title={t.title} lede={t.lede}>
    <p style="margin-top:28px; display:flex; flex-wrap:wrap; gap:12px;">
      <a class="act solid" href="/">{t.cta}</a>
      <a class="act ghost" href="/pt/">Versão em Português</a>
    </p>
  </PageHead>
</Base>

---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CvPrint from '../components/CvPrint.astro';
import ArticleFigure from '../components/ArticleFigure.astro';
import { education, awards, reviewer, links, projects, statusLabel, works, workFigure } from '../lib/works';
import { UI, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].cv;
const experienceIcons = ['data', 'code', 'cube', 'layers'] as const;
const benchWork = works.find((work) => work.doi === '10.1098/rsta.2024.0363');
const benchFigure = benchWork && workFigure(benchWork);

const portraitCandidates = ['portrait.jpg', 'portrait.jpeg', 'portrait.png', 'portrait.webp'];
const foundPortrait = portraitCandidates.find((file) => existsSync(join(process.cwd(), 'public', file)));
const portraitSrc = foundPortrait ? `/${foundPortrait}` : null;
const printPortraitSrc = existsSync(join(process.cwd(), 'public', 'portrait-face.jpg')) ? '/portrait-face.jpg' : portraitSrc;
---
<Base title={t.title} current="/cv/" lang={lang}>
  <div class="cv-screen">
  <PageHead title={t.title} lede={t.lede} hasAside={true}>
    <p class="print-options-label">{t.printTitle}</p>
    <div class="cv-print-actions" role="group" aria-label={t.printTitle}>
      <button type="button" class="cv-print-button taped" data-print-cv="professional"><Icon name="print" /> {t.printProfessional}</button>
      <button type="button" class="cv-print-button cv-print-academic taped" data-print-cv="academic"><Icon name="print" /> {t.printAcademic}</button>
    </div>
    <p class="ph-acts">
      <a class="act ghost" href={links.lattes}>{t.lattes} <Icon name="arrow" /></a>
      <a class="act ghost" href={links.orcid}>{t.orcid} <Icon name="arrow" /></a>
      <a class="act ghost" href={links.linkedin}>LinkedIn <Icon name="arrow" /></a>
      {Astro.site && <a class="act ghost" href={Astro.site.href}>{Astro.site.hostname} <Icon name="arrow" /></a>}
    </p>
    <div slot="aside" class="portrait-circle sticker" style="--tilt:3deg">
      {portraitSrc ? (
        <img
          src={portraitSrc}
          alt={t.portraitAlt}
          width="184"
          height="184"
          loading="eager"
          decoding="async"
        />
      ) : (
        <div class="portrait-monogram" role="img" aria-label={t.portraitAlt}>
          <span class="mono-mark">EBA</span>
        </div>
      )}
    </div>
  </PageHead>
  </div>

  <div class="paper cv">
    <div class="wrap">
      <section aria-labelledby="pos">
        <h2 id="pos">{t.sections.positions}</h2>
        <ul>
          {t.positions.map((p) => (
            <li>
              <span class="mono">{p.span}</span>
              <span><strong>{p.role}</strong> · {p.org}<br />{p.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="edu">
        <h2 id="edu">{t.sections.education}</h2>
        <ul>
          {education.map((e) => {
            const deg = lang === 'pt' && e.degree_pt ? e.degree_pt : e.degree;
            const note = lang === 'pt' && e.note_pt ? e.note_pt : e.note;
            return (
              <li>
                <span class="mono">{e.span}</span>
                <span><strong>{deg}</strong> · {e.org}<br />{note}</span>
              </li>
            );
          })}
        </ul>
      </section>

      <section aria-labelledby="aw">
        <h2 id="aw">{t.sections.awards}</h2>
        <ul>
          {awards.map((a) => (
            <li>
              <span class="mono">{a.year}</span>
              <span><strong>{lang === 'pt' && a.name_pt ? a.name_pt : a.name}</strong></span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="pr">
        <h2 id="pr">{t.sections.projects}</h2>
        <ul>
          {projects.map((p) => {
            const pName = lang === 'pt' && p.name_pt ? p.name_pt : p.name;
            const pRole = lang === 'pt' && p.role_pt ? p.role_pt : p.role;
            return (
              <li>
                <span class="mono">{p.span}</span>
                <span>
                  <strong>{pName}</strong>
                  {p.trl && <span class="trl-tag mono"> · TRL {p.trl[0]}–{p.trl[1]}</span>}
                  <br />{pRole} · {lang === 'pt' && p.org_pt ? p.org_pt : p.org}
                  {p.confidential && <><br /><span class="stage" data-status="confidential">{statusLabel('confidential', lang)}</span></>}
                </span>
              </li>
            );
          })}
        </ul>
      </section>

    </div>

    <div class="cv-showcases">
      <div class="wrap">
        <section class="cv-showcase" aria-labelledby="practical">
          <h2 id="practical">{t.practicalTitle}</h2>
          <div class:list={['practice-layout', { 'has-bench': benchFigure }]}>
            <ul class="experience-list">
              {t.practical.map((experience, index) => (
                <li class="cv-experience">
                  <span class="experience-mark" aria-hidden="true"><Icon name={experienceIcons[index]} /></span>
                  <div>
                    <h3>{experience.title}</h3>
                    <p>{experience.body}</p>
                  </div>
                </li>
              ))}
            </ul>
            {benchFigure && <div class="practice-figure"><ArticleFigure image={benchFigure} lang={lang} /></div>}
          </div>
        </section>

        <section class="cv-showcase" aria-labelledby="sk">
          <h2 id="sk">{t.sections.skills}</h2>
          <div class="skills-list">
            {t.skillGroups.map(({ title, skills }) => (
              <div class="cv-skill-group">
                <h3 class="subject-label">{title}</h3>
                <ul class="skill-points">{skills.map((skill) => <li>{skill}</li>)}</ul>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <div class="wrap">
      <section class="academic-review" aria-labelledby="rv">
        <h2 id="rv">{t.sections.reviewer}</h2>
        <ul>
          {reviewer.map((r) => <li><span></span><span>{r}</span></li>)}
        </ul>
      </section>

      <section aria-labelledby="lg">
        <h2 id="lg">{t.sections.languages}</h2>
        <ul>
          <li><span></span><span>{t.languagesText}</span></li>
        </ul>
      </section>
    </div>
  </div>
  <CvPrint lang={lang} portrait={printPortraitSrc} />
</Base>

<style>
  .cv-print-actions, .ph-acts { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 0; }
  .print-options-label { font-size: 0.88rem; color: var(--ink-soft); font-weight: 650; margin: 16px 0 0; }
  .cv-print-actions { gap: 14px 16px; margin-top: 8px; padding-block: 4px; }
  .cv-print-button {
    --button-tilt: -1deg;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px;
    border: 1.5px solid #ff7a59;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: var(--ink);
    color: #fff;
    font: 700 0.94rem/1.2 var(--sans);
    box-shadow: 0 3px 0 var(--ink);
    transform: rotate(var(--button-tilt));
    cursor: pointer;
  }
  .cv-print-academic { --button-tilt: 1deg; border-color: var(--ink); background: var(--name-highlight, #f6a593); color: var(--ink); }
  .cv-print-button :global(svg) { width: 18px; height: 18px; flex: none; }
  .cv-print-button::before { top: -7px; right: 4px; width: 30px; height: 11px; pointer-events: none; }
  .cv-print-button:hover { transform: translateY(-1px); box-shadow: 0 4px 0 var(--ink); }
  .cv-print-button:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--ink); }
  .ph-acts .act { font-size: 0.88rem; }
  .portrait-circle {
    width: 200px;
    height: 200px;
    flex-shrink: 0;
  }
  .portrait-circle img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 9px;
    object-fit: cover;
    object-position: center;
  }
  .portrait-monogram {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--plate);
  }
  .mono-mark {
    font: 600 2.2rem/1 var(--sans);
    color: var(--signal);
  }

  .cv { padding-block: 24px 112px; }
  .cv > .wrap > section { display: grid; grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); gap: 16px 56px; padding-block: 40px; border-bottom: 1.5px solid var(--ink); }
  h2 { font: 500 clamp(1.7rem, 3vw, 2.3rem)/1.05 var(--sans); }
  ul { list-style: none; margin: 0; padding: 0; }
  .cv > .wrap > section li { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); color: var(--ink-soft); }
  li:last-child { border-bottom: 0; }
  li .mono { padding-top: 3px; }
  strong { color: var(--ink); font-weight: 600; }
  .cv-showcases { background: #fff; border-bottom: 1.5px solid var(--ink); }
  .cv-showcase { padding-block: clamp(28px, 5vw, 64px); }
  .cv-showcase + .cv-showcase { border-top: 1px solid var(--rule); }
  .cv-showcase h2 { font-weight: 650; }
  .practice-layout { margin-top: 22px; }
  .practice-layout.has-bench { display: grid; grid-template-columns: minmax(0, 1fr) minmax(210px, 300px); gap: 26px 44px; align-items: center; }
  .experience-list { border-top: 1px solid var(--rule); }
  .cv-experience { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 12px; padding-block: 16px; border-bottom: 1px solid var(--rule); }
  .experience-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 36px;
    border: 1px solid var(--ink);
    border-radius: 105px 10px 90px 12px / 12px 76px 10px 68px;
    background: var(--plate);
    color: var(--ink);
    box-shadow: 0 2px 0 var(--ink);
    transform: rotate(-5deg);
  }
  .cv-experience:nth-child(even) .experience-mark { background: var(--name-highlight, #f6a593); transform: rotate(4deg); }
  .experience-mark :global(svg) { width: 19px; height: 19px; }
  .cv-experience h3, .cv-skill-group h3 { font-size: 1rem; color: var(--ink); }
  .cv-experience p { margin: 6px 0 0; color: var(--ink-soft); max-width: 66ch; }
  .practice-figure { padding: 9px 16px 0 6px; }
  .skills-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; margin-top: 24px; }
  .cv-skill-group { border-top: 1px solid var(--rule); padding-top: 13px; }
  .subject-label {
    display: inline-block;
    max-width: 100%;
    padding: 5px 9px;
    border: 1px solid var(--ink);
    border-radius: 130px 12px 105px 15px / 10px 80px 12px 70px;
    background: var(--plate);
    transform: rotate(-1deg);
  }
  .cv-skill-group:nth-child(even) .subject-label { background: var(--name-highlight, #f6a593); transform: rotate(1deg); }
  .skill-points { list-style: disc; padding-left: 1.25em; margin-top: 10px; color: var(--ink-soft); }
  .skill-points li + li { margin-top: 5px; }
  .skill-points li::marker { color: var(--ink); }
  @media (max-width: 820px) { .portrait-circle { width: 160px; height: 160px; } }
  @media (max-width: 760px) {
    .cv > .wrap > section { grid-template-columns: 1fr; }
    .cv > .wrap > section li { grid-template-columns: 84px minmax(0, 1fr); }
    .practice-layout.has-bench { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .skills-list { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .cv { padding-block: 8px 56px; }
    .cv > .wrap > section { padding-block: 24px; }
    .cv > .wrap > section li { grid-template-columns: 64px minmax(0, 1fr); gap: 12px; }
  }
  .trl-tag { font-size: 0.72rem; color: var(--ink-soft); white-space: nowrap; }

</style>

<script>
  const cv = document.querySelector<HTMLElement>('[data-cv-format]');
  if (cv) {
    document.querySelectorAll<HTMLButtonElement>('[data-print-cv]').forEach((button) => {
      button.addEventListener('click', () => {
        cv.dataset.cvFormat = button.dataset.printCv;
        window.print();
      });
    });
    window.addEventListener('afterprint', () => { cv.dataset.cvFormat = 'professional'; });
  }
</script>

---
import Base from '../layouts/Base.astro';
import ArticleFigure from '../components/ArticleFigure.astro';
import CitationCopy from '../components/CitationCopy.astro';
import PageHead from '../components/PageHead.astro';
import DoiLogo from '../components/DoiLogo.astro';
import Icon from '../components/Icon.astro';
import { lines, works, statusLabel, publicStatus, typeLabel, workFigure, doiUrl } from '../lib/works';
import { UI, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].electrolyzers;
const home = UI[lang].home;

const series = works.filter((w) => w.series).sort((a, b) => (a.series! < b.series! ? -1 : 1));
const paper01 = series.find((w) => w.series === '01');
const gallery = lines.find((l) => l.id === 'electrolysis')?.gallery ?? [];
---
<Base title={t.title} description={t.lede} current="/electrolyzers/" lang={lang}>
  <PageHead title={t.title} lede={t.lede}>
    <p class="ph-acts">
      {paper01?.doi && <a class="act solid" href={doiUrl(paper01.doi)}><DoiLogo /> Paper 01 · IJHE 2025</a>}
    </p>
  </PageHead>

  <section class="paper papers" aria-labelledby="papers-title" data-line="electrolysis">
    <div class="wrap">
      <h2 id="papers-title" class="section-title">{t.seriesTitle}</h2>
      <p class="section-lede">{t.seriesLede}</p>
      <ol class="mle ticked">
        {series.map((w) => {
          const cid = `paper-${w.series}`;
          const figure = workFigure(w);
          const status = publicStatus(w);
          const citation = w.status === 'published' && w.doi
            ? [w.authors, w.title, w.venue].filter(Boolean).join('. ') + '. doi:' + w.doi
            : undefined;
          return (
            <li>
              <div class="row">
                <span class="mle-no mono">{w.series}</span>
                <div class="mle-meta">
                  <div class="mle-tags">
                    <span class="publication-type" data-type={w.type}>{typeLabel(w.type, lang)}</span>
                    <span class="stage" data-status={status}>{statusLabel(status, lang)}</span>
                  </div>
                  <h3 class="mle-title">{w.title}</h3>
                  {status === 'published' && <p class="mle-venue">{w.venue}</p>}
                </div>
                <div class="mle-links">
                  {w.doi && <a class="article-link primary" href={doiUrl(w.doi)} title={w.doi}><DoiLogo /> DOI</a>}
                  <button type="button" class="act solid peel" aria-expanded="false" aria-controls={cid}>
                    <span class="peel-label"><span class="peel-open">{t.peelLabel}</span><span class="peel-close">{t.closeLabel}</span></span>
                    <Icon name="chevron-right" />
                  </button>
                </div>
              </div>
              <div class:list={['paper-card', { 'has-figure': figure }]} id={cid} hidden>
                <section class="article-brief brush" data-article-summary aria-labelledby={`${cid}-headline`}>
                  <h4 class="pc-k" id={`${cid}-headline`}>{t.summaryLabel}</h4>
                  <p class="pc-sum">{t.summaries[w.series!]}</p>
                  {citation ? (
                    <div class="pc-source">
                      <p class="pc-citation mono" id={`${cid}-citation`}>{citation}</p>
                      <CitationCopy citationId={`${cid}-citation`} lang={lang} />
                    </div>
                  ) : (
                    <p class="pc-foot">{t.embargo}{!w.doi && <span> · {home.mlePending}</span>}</p>
                  )}
                </section>
                {figure && <div class="paper-figure"><ArticleFigure image={figure} lang={lang} /></div>}
              </div>
            </li>
          );
        })}
      </ol>
      <p class="acts">
        <a class="act" href={localePath('/open-science/', lang)}>{UI[lang].openScience.title} <Icon name="arrow" /></a>
        <a class="act" href={`${localePath('/research/', lang)}#electrolysis`}>{UI[lang].research.title} <Icon name="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- 2 · the hardware, as taped stickers -->
  {gallery.length > 0 && (
    <section class="paper hw" aria-labelledby="hw-title" data-line="electrolysis">
      <div class="wrap">
        <h2 id="hw-title" class="section-title">{t.galleryTitle}</h2>
        <div class="hw-grid">
          {gallery.map((g, i) => (
            <figure class="hw-fig">
              <span class="sticker" style={`--tilt:${i % 2 ? '2.4deg' : '-2.2deg'}`}>
                <img src={g.src} alt={lang === 'pt' && g.alt_pt ? g.alt_pt : g.alt} width="300" height="300" loading="lazy" decoding="async" />
              </span>
              {g.caption && <figcaption>{lang === 'pt' && g.caption_pt ? g.caption_pt : g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .ph-acts { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0 0; }

  .papers { padding-block: clamp(28px, 5vw, 64px); }
  .mle { list-style: none; margin: 40px 0 36px; padding: 0; color: var(--ink); }
  .mle > li { border-bottom: 1px solid var(--rule); }
  .row { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 14px 20px; align-items: start; padding: 22px 0; }
  .mle-no { color: var(--ink-soft); font-size: 0.92rem; font-weight: 650; padding-top: 4px; }
  .mle-tags, .mle-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .mle-title { margin-top: 8px; font: 650 clamp(1.08rem, 2vw, 1.32rem)/1.3 var(--sans); }
  .mle-venue { margin: 4px 0 0; color: var(--ink-soft); font-size: 0.92rem; }
  .mle .stage { color: var(--ink-soft); }
  .mle-links { align-self: center; }
  .peel { min-height: 44px; padding: 7px 13px; border-radius: 999px; font-size: 0.86rem; }
  .peel :global(svg) { width: 16px; height: 16px; flex: none; }
  .peel:hover :global(svg) { transform: none; }
  .peel-label { display: grid; }
  .peel-label > span { grid-area: 1 / 1; }
  .peel-close { visibility: hidden; }
  .peel[aria-expanded='true'] { box-shadow: 1px 1px 0 var(--shadow-ink); }
  .peel[aria-expanded='true'] :global(svg) { transform: rotate(90deg); }
  .peel[aria-expanded='true'] .peel-open { visibility: hidden; }
  .peel[aria-expanded='true'] .peel-close { visibility: visible; }
  .paper-card { margin: 0 0 26px 56px; }
  .paper-card.has-figure:not([hidden]) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 260px); align-items: center; gap: 24px 32px; }
  .article-brief { min-width: 0; max-width: 64rem; padding: clamp(38px, 5vw, 62px) clamp(22px, 5vw, 58px); }
  .pc-k { margin: 0 0 10px; font: 650 clamp(1.15rem, 2vw, 1.55rem)/1.2 var(--sans); }
  .pc-sum { margin: 0; max-width: 66ch; line-height: 1.6; }
  .pc-foot { margin: 14px 0 0; max-width: 66ch; font-size: 0.9rem; }
  .pc-source { margin-top: 17px; padding-top: 12px; border-top: 1px solid rgb(255 255 255 / 36%); }
  .pc-citation { margin: 0 0 10px; max-width: 72ch; line-height: 1.6; overflow-wrap: anywhere; }
  .paper-figure { min-width: 0; padding: 7px 13px 0 4px; }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
  @media (max-width: 900px) {
    .article-brief { padding-block: 72px; }
    .paper-card.has-figure:not([hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .row { grid-template-columns: 28px minmax(0, 1fr); gap: 10px; }
    .mle-links { grid-column: 2; }
    .paper-card { margin-left: 0; }
    .pc-citation { font-size: 0.85rem; }
  }

  .hw { padding-block: clamp(56px, 7vw, 88px); }
  .hw-grid { display: flex; flex-wrap: wrap; gap: 40px 56px; margin-top: 36px; }
  .hw-fig { margin: 0; width: min(100%, 300px); display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .hw-fig .sticker { width: 100%; }
  .hw-fig .sticker img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: #fff; }
  .hw-fig figcaption { color: var(--ink-soft); font: 500 1rem/1.3 var(--sans); padding-left: 4px; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.peel').forEach((b) =>
    b.addEventListener('click', () => {
      const card = document.getElementById(b.getAttribute('aria-controls')!);
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      if (card) card.hidden = !open;
    }),
  );
</script>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { links, works } from '../lib/works';
import { UI, localePath, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].openScience;
const designRepo = works.find((work) => work.series === '01' && work.status === 'published')?.github;
---

<Base title={t.title} description={t.lede} current="/open-science/" lang={lang}>
  <PageHead title={t.title} lede={t.lede} />

  <section class="paper resources" aria-labelledby="resources-title">
    <div class="wrap">
      <h2 id="resources-title" class="section-title">{t.resourcesTitle}</h2>
      <ul class="resource-list">
        <li>
          <div><h3>GitHub</h3><p>{t.githubNote}</p></div>
          <a class="act" href={links.github}>GitHub <Icon name="arrow" /></a>
        </li>
        <li>
          <div><h3>Zenodo</h3><p>{t.zenodoNote}</p></div>
          <a class="act" href={links.zenodo}>{t.zenodoBtn} <Icon name="arrow" /></a>
        </li>
        {designRepo && (
          <li id="electrolyzer-cad">
            <div><h3>{t.designTitle}</h3><p>{t.designNote}</p></div>
            <a class="act" href={designRepo}>{t.designLink} <Icon name="arrow" /></a>
          </li>
        )}
      </ul>
      <a class="series-link" href={localePath('/electrolyzers/', lang)}>{t.seriesLink}</a>
    </div>
  </section>

  <section class="paper how" aria-labelledby="how-title">
    <div class="wrap how-grid">
      <h2 id="how-title" class="section-title">{t.howTitle}</h2>
      <div>
        <p>{t.howP1}</p>
        <p>{t.howP2}</p>
        <a class="act" href={`mailto:${links.email}?subject=Data%20or%20code%20request`}><Icon name="mail" /> {t.requestBtn}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .resources, .how { padding-block: clamp(28px, 5vw, 64px); }
  .resource-list { list-style: none; padding: 0; margin: 24px 0 18px; border-top: 1px solid var(--rule); }
  .resource-list li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding-block: 18px; border-bottom: 1px solid var(--rule); }
  .resource-list h3 { font-size: 1.25rem; }
  .resource-list p { margin: 6px 0 0; color: var(--ink-soft); }
  .resource-list .act { max-width: 100%; line-height: 1.2; }
  .series-link { color: var(--ink); }
  #electrolyzer-cad { scroll-margin-top: 116px; }
  .how { border-top: 1px solid var(--rule); }
  .how-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 18px 48px; }
  .how p { max-width: var(--measure); color: var(--ink-soft); margin: 0 0 16px; }
  @media (max-width: 760px) { .how-grid { grid-template-columns: 1fr; } }
</style>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import WorkItem from '../components/WorkItem.astro';
import Icon from '../components/Icon.astro';
import { works, SERIES, SERIES_ORDER, seriesLabel, statusLabel } from '../lib/works';
import { UI, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].publications;

const years = [...new Set(works.map((w) => w.year))].sort((a, b) => b - a);
const types = ['journal', 'conference', 'chapter', 'thesis'] as const;
const statuses = ['published', 'confidential', 'in-preparation'] as const;
const yMin = Math.min(...years), yMax = Math.max(...years);
---
<Base title={t.title} current="/publications/" lang={lang}>
  <PageHead title={t.title} lede={t.lede} />
  <section class="paper pubs">
    <div class="wrap">
      <div class="filters ticked" role="search" aria-label={t.filterLabel}>
        <div class="search-row">
          <div class="search-box">
            <Icon name="search" />
            <input id="q" class="q" type="search" placeholder={t.fSearch} aria-label={t.fSearch} />
          </div>
        </div>
        <div class="frow quick-filters" role="group" aria-label={t.fTheme}>
          <span class="fl mono">{t.fTheme}</span>
          {SERIES_ORDER.map((id) => (
            <button type="button" class="f taped" data-line={id} data-kind="line" aria-pressed="false" title={seriesLabel(id, lang)}>
              <span class="series-mark" aria-hidden="true">{SERIES[id].symbol}</span>{t.topics[id]}
            </button>
          ))}
        </div>
        <div class="frow quick-filters" role="group" aria-label={t.fType}>
          <span class="fl mono">{t.fType}</span>
          {types.map((type) => (
            <button type="button" class="f taped" data-type={type} data-kind="type" aria-pressed="false">{t.category[type]}</button>
          ))}
        </div>
        <details class="advanced">
          <summary><Icon name="chevron-right" /><span>{t.moreFilters}</span><span class="advanced-count mono" hidden></span></summary>
          <div class="advanced-fields">
            <div class="frow" role="group" aria-label={t.fStatus}>
              <span class="fl mono">{t.fStatus}</span>
              {statuses.map((status) => (
                <button type="button" class="f taped" data-status={status} data-kind="status" aria-pressed="false">{statusLabel(status, lang)}</button>
              ))}
            </div>
            <div class="frow" role="group" aria-label={t.fYears}>
              <span class="fl mono">{t.fYears}</span>
              <label class="yrsel">{t.fFrom}
                <select id="yFrom">{years.slice().reverse().map((y) => <option value={y} selected={y === yMin}>{y}</option>)}</select>
              </label>
              <label class="yrsel">{t.fTo}
                <select id="yTo">{years.slice().reverse().map((y) => <option value={y} selected={y === yMax}>{y}</option>)}</select>
              </label>
            </div>
          </div>
        </details>
        <div class="filter-footer">
          <p class="count" aria-live="polite"><span id="n" class="mono">{works.length}</span> {t.shownOf} <span class="mono">{works.length}</span> {t.shownSuffix}</p>
          <button type="button" class="clear" id="clear">{t.fClear}</button>
        </div>
      </div>
      {years.map((y) => (
        <section class="yr" data-year={y}>
          <h2>{y}</h2>
          <ul class="ticked">{works.filter((w) => w.year === y).map((w) => <WorkItem w={w} lang={lang} showFigure />)}</ul>
        </section>
      ))}
      <p class="empty" hidden>{t.empty}</p>
    </div>
  </section>
</Base>

<style>
  .pubs { padding-block: clamp(24px, 4vw, 56px) clamp(56px, 8vw, 112px); }
  .filters { display: grid; gap: 10px; padding-block: 24px 6px; border-bottom: 1px solid var(--rule); color: var(--ink); }
  .search-row { margin-bottom: 4px; }
  .search-box { position: relative; max-width: 35rem; }
  .search-box :global(svg) { position: absolute; inset: 0 auto 0 14px; margin-block: auto; width: 21px; height: 21px; pointer-events: none; }
  .q, .yrsel select {
    min-height: 44px;
    border: 1px solid #536787;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font: 500 0.94rem/1.2 var(--sans);
    padding: 8px 12px;
  }
  .q { width: 100%; padding-inline-start: 42px; box-shadow: 0 2px 0 var(--plate); }
  .q::placeholder { color: var(--ink-soft); opacity: 1; }
  .frow, .filter-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .frow { gap: 12px 10px; }
  .f {
    --filter-ink: var(--c-ink, var(--ink));
    --filter-depth: color-mix(in srgb, var(--filter-ink) 76%, #06103d);
    --filter-face: color-mix(in srgb, var(--filter-ink) 8%, var(--paper));
    --filter-tilt: -0.8deg;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 7px;
    min-height: 44px;
    padding: 7px 12px;
    max-width: 100%;
    border: 1.5px solid var(--filter-ink);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: var(--filter-face);
    color: var(--filter-ink);
    box-shadow: 0 3px 0 var(--filter-depth), 0 8px 12px -9px var(--filter-depth);
    transform: rotate(var(--filter-tilt));
    font: 700 0.88rem/1.2 var(--sans);
    text-align: left;
    cursor: pointer;
  }
  .f:nth-of-type(even) { --filter-tilt: 0.8deg; }
  .f[data-type] { --filter-face: color-mix(in srgb, var(--name-highlight, #ff7a59) 34%, var(--paper)); }
  .f.taped::before { display: none; top: -5px; right: 4px; width: 26px; height: 11px; pointer-events: none; }
  .f.taped[aria-pressed='true']::before { display: block; }
  .series-mark { display: inline-flex; align-items: center; gap: 5px; font-weight: 750; flex: none; }
  .series-mark::before { content: ''; width: 3px; height: 14px; border-radius: 2px; background: currentColor; }
  .f[data-status='published'] { --filter-ink: #155436; }
  .f[data-status='confidential'] { --filter-ink: #b01833; }
  @media (hover: hover) {
    .f[aria-pressed='false']:hover {
      background: color-mix(in srgb, var(--filter-ink) 8%, var(--filter-face));
      box-shadow: 0 4px 0 var(--filter-depth);
      transform: translateY(-1px) rotate(0);
    }
  }
  .f[aria-pressed='true'] {
    background: var(--filter-ink);
    color: #fff;
    border-color: #ff7a59;
    box-shadow: 0 1px 0 var(--filter-depth);
    transform: translateY(2px);
  }
  .f:active { box-shadow: 0 1px 0 var(--filter-depth); transform: translateY(2px); }
  @media (prefers-reduced-motion: no-preference) {
    .f { transition: transform 0.16s var(--ease-out), box-shadow 0.16s var(--ease-out), background-color 0.16s var(--ease-out); }
  }
  .filters :is(button, input, select, summary):focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .fl { font-size: 0.72rem; font-weight: 650; min-width: 64px; color: var(--ink-soft); }
  .advanced summary {
    display: flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    min-height: 44px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
  }
  .advanced summary::-webkit-details-marker { display: none; }
  .advanced summary:hover { background: var(--plate); }
  .advanced summary :global(svg) { width: 16px; height: 16px; }
  .advanced[open] summary :global(svg) { transform: rotate(90deg); }
  .advanced-count { padding: 3px 6px; border-radius: 999px; background: var(--ink); color: #fff; }
  .advanced-fields { display: grid; gap: 8px; padding-top: 8px; }
  .yrsel { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: var(--ink-soft); }
  .filter-footer { justify-content: space-between; }
  .clear { min-height: 44px; padding: 6px 8px; border: 0; border-radius: 6px; background: none; color: var(--ink); font: 600 0.86rem/1.2 var(--sans); text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
  .clear:hover { background: var(--plate); }
  .count { margin: 0; color: var(--ink-soft); font-size: 0.88rem; }
  .count .mono { font-size: 0.82rem; }
  .yr[hidden], .yr :global(.wi[hidden]) { display: none; }
  .yr { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 20px; padding-block: 20px 6px; }
  .yr ul { list-style: none; margin: 0; padding: 0; }
  .yr h2 { font: 550 2.15rem/1 var(--sans); padding-top: 18px; position: sticky; top: 88px; align-self: start; }
  .yr ul > :global(li:last-child) { border-bottom: 0; }
  .empty { padding: 40px 0; font-size: 1.1rem; }
  @media (max-width: 760px) {
    .yr { grid-template-columns: 1fr; gap: 10px; }
    .yr h2 { position: static; font-size: 1.8rem; }
    .fl { flex-basis: 100%; }
  }
  @media (max-width: 520px) {
    .quick-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quick-filters .fl { grid-column: 1 / -1; }
    .quick-filters .f { gap: 5px; padding-inline: 8px; font-size: 0.82rem; }
  }
</style>

<script>
  /* filters: nothing selected in a group = everything in that group */
  const fs = [...document.querySelectorAll<HTMLButtonElement>('.f')];
  const items = [...document.querySelectorAll<HTMLElement>('.wi')];
  const yFrom = document.getElementById('yFrom') as HTMLSelectElement;
  const yTo = document.getElementById('yTo') as HTMLSelectElement;
  const q = document.getElementById('q') as HTMLInputElement;
  const advancedCount = document.querySelector<HTMLElement>('.advanced-count')!;
  const sel = (k: string) => new Set(fs.filter((f) => f.dataset.kind === k && f.getAttribute('aria-pressed') === 'true').map((f) => f.dataset[k]!));
  function apply() {
    const lines = sel('line'), types = sel('type'), sts = sel('status');
    const a = Math.min(+yFrom.value, +yTo.value), b = Math.max(+yFrom.value, +yTo.value);
    const rangeActive = a !== Number(yFrom.options[0].value) || b !== Number(yTo.options[yTo.options.length - 1].value);
    const extraFilters = sts.size + Number(rangeActive);
    advancedCount.hidden = extraFilters === 0;
    advancedCount.textContent = String(extraFilters);
    const term = q.value.trim().toLowerCase();
    let n = 0;
    items.forEach((i) => {
      const y = +(i.closest<HTMLElement>('.yr')!.dataset.year!);
      const show = (!lines.size || lines.has(i.dataset.line!)) && (!types.size || types.has(i.dataset.type!)) && (!sts.size || sts.has(i.dataset.status!))
        && y >= a && y <= b && (!term || `${i.querySelector('.wi-body')?.textContent} ${i.dataset.doi ?? ''}`.toLowerCase().includes(term));
      i.hidden = !show; if (show) n++;
    });
    document.querySelectorAll<HTMLElement>('.yr').forEach((s) => { s.hidden = !s.querySelector('.wi:not([hidden])'); });
    document.getElementById('n')!.textContent = String(n);
    (document.querySelector('.empty') as HTMLElement).hidden = n > 0;
  }
  fs.forEach((f) => f.addEventListener('click', () => { f.setAttribute('aria-pressed', String(f.getAttribute('aria-pressed') !== 'true')); apply(); }));
  [yFrom, yTo].forEach((s) => s.addEventListener('change', apply));
  q.addEventListener('input', apply);
  document.getElementById('clear')!.addEventListener('click', () => {
    fs.forEach((f) => f.setAttribute('aria-pressed', 'false'));
    yFrom.selectedIndex = 0; yTo.selectedIndex = yTo.options.length - 1; q.value = ''; apply();
  });
</script>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import WorkItem from '../components/WorkItem.astro';
import ZoomFigure, { type InfoRow } from '../components/ZoomFigure.astro';
import { lines, SERIES, worksOf, tools, projects, placedWorks, yearToPct, type ProjectEntry, type LineId } from '../lib/works';
import { UI, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].research;
const placed = placedWorks(lang);
const lineName = (id: LineId) => {
  const l = lines.find((x) => x.id === id)!;
  return lang === 'pt' && l.name_pt ? l.name_pt : l.name;
};
const projName = (p: ProjectEntry) => (lang === 'pt' && p.name_pt ? p.name_pt : p.name);
/* project record shown in the image viewer; rows without confirmed data are left out */
function projectInfo(p: ProjectEntry | undefined, line: LineId, ref?: string): InfoRow[] {
  const f = t.figInfo;
  const rows: (InfoRow | false)[] = [
    !!p && { label: f.project, value: projName(p) },
    !!p?.code && { label: f.code, value: p.code },
    !!p?.sponsor && { label: f.sponsor, value: p.sponsor },
    !!p && { label: f.org, value: lang === 'pt' && p.org_pt ? p.org_pt : p.org },
    !!p && { label: f.period, value: p.span },
    !!p?.trl && { label: f.trl, value: `TRL ${p.trl[0]}–${p.trl[1]}` },
    !!p && { label: f.role, value: lang === 'pt' && p.role_pt ? p.role_pt : p.role },
    { label: f.line, value: lineName(line) },
    !!ref && { label: f.ref, value: ref },
  ];
  return rows.filter(Boolean) as InfoRow[];
}
---
<Base title={t.title} current="/research/" lang={lang}>
  <PageHead title={t.title} lede={t.lede}>
    <nav class="jump" aria-label={lang === 'pt' ? 'Ir para a linha de pesquisa' : 'Jump to a research line'}>
      {lines.map((l, i) => (
        <a class="jump-st" data-line={l.id} href={`#${l.id}`} style={`--tilt:${[-2.4, 1.8, -1.2, 2.2, -1.8][i % 5]}deg`}>
          <b>{SERIES[l.id].symbol}</b>{lineName(l.id)}
        </a>
      ))}
      <a class="jump-st proj" href="#proj-title" style="--tilt:1.4deg"><b>★</b>{t.projectsTitle}</a>
    </nav>
  </PageHead>
  <div class="paper">
    {lines.map((l) => {
      const lName = lang === 'pt' && l.name_pt ? l.name_pt : l.name;
      const lSummary = lang === 'pt' && l.summary_pt ? l.summary_pt : l.summary;
      const lineTools = tools.filter((tool) => tool.line === l.id);
      return (
        <section class="ser" id={l.id} data-line={l.id} aria-labelledby={`t-${l.id}`}>
          <div class="wrap ser-grid">
            <header class="ser-head">
              <h2 id={`t-${l.id}`}>{lName}</h2>
              <p class="ser-sym">{SERIES[l.id].symbol}<span class="mono">{SERIES[l.id].nm.toFixed(1)} nm · {l.span}</span></p>
              <div class="mini" aria-hidden="true">
                {placed.map((w) => <i data-on={w.line === l.id ? '1' : '0'} data-status={w.status} style={`left:${w.pct}%`}></i>)}
                <b class="mono" style={`left:${yearToPct(2016)}%`}>2016</b><b class="mono" style={`left:${yearToPct(2026)}%`}>2026</b>
              </div>
              <p class="ser-sum">{lSummary}</p>
              {l.gallery && l.gallery.some((g) => !g.wide) && (
                <div class="ser-gallery">
                  {l.gallery.filter((g) => !g.wide).map((g) => {
                    const proj = projects.find((p) => p.name === g.project);
                    const cap = lang === 'pt' && g.caption_pt ? g.caption_pt : g.caption;
                    return (
                      <ZoomFigure
                        src={lang === 'pt' && g.src_pt ? g.src_pt : g.src}
                        alt={lang === 'pt' && g.alt_pt ? g.alt_pt : g.alt}
                        title={proj ? projName(proj) : lName}
                        caption={cap}
                        info={projectInfo(proj, l.id, g.ref)}
                        legend={(lang === 'pt' && g.legend_pt ? g.legend_pt : g.legend) ?? []}
                        hotspots={g.hotspots ?? []}
                        lang={lang}
                      />
                    );
                  })}
                </div>
              )}
            </header>
            <div>
              {l.gallery?.filter((g) => g.wide).map((g) => {
                const proj = projects.find((p) => p.name === g.project);
                const cap = lang === 'pt' && g.caption_pt ? g.caption_pt : g.caption;
                return (
                  <div class="ser-wide">
                    <ZoomFigure
                      src={lang === 'pt' && g.src_pt ? g.src_pt : g.src}
                      alt={lang === 'pt' && g.alt_pt ? g.alt_pt : g.alt}
                      title={proj ? projName(proj) : lName}
                      caption={cap}
                      info={projectInfo(proj, l.id, g.ref)}
                      legend={(lang === 'pt' && g.legend_pt ? g.legend_pt : g.legend) ?? []}
                      hotspots={g.hotspots ?? []}
                      wide
                      lang={lang}
                    />
                  </div>
                );
              })}
              {worksOf(l.id).length > 0 && <ul class="ser-list ticked">{worksOf(l.id).map((w) => <WorkItem w={w} lang={lang} />)}</ul>}
              {lineTools.length > 0 && (
                <div class="tools">
                  <h3>{t.toolsTitle}</h3>
                  <ul>
                    {lineTools.map((tool) => {
                      const tName = lang === 'pt' && tool.name_pt ? tool.name_pt : tool.name;
                      const tNote = lang === 'pt' && tool.note_pt ? tool.note_pt : tool.note;
                      return (
                        <li><span class="mono">{tool.year}</span><span><strong>{tName}</strong><br />{tNote}</span></li>
                      );
                    })}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })}
    <section class="projects" aria-labelledby="proj-title">
      <div class="wrap">
        <h2 id="proj-title" class="section-title">{t.projectsTitle}</h2>
        <ul class="ticked">
          {projects.map((p) => {
            const pName = lang === 'pt' && p.name_pt ? p.name_pt : p.name;
            const pRole = lang === 'pt' && p.role_pt ? p.role_pt : p.role;
            const pAlt = lang === 'pt' && p.image_alt_pt ? p.image_alt_pt : (p.image_alt ?? pName);
            const pCap = lang === 'pt' && p.image_caption_pt ? p.image_caption_pt : p.image_caption;
            const sponsor = p.sponsor ? ` · ${t.figInfo.sponsor}: ${p.sponsor}` : '';
            return (
              <li class:list={{ 'has-img': !!p.image }}>
                <span class="mono">{p.span}</span>
                <span><strong>{pName}</strong>{p.trl && <span class="trl-tag mono"> · TRL {p.trl[0]}–{p.trl[1]}</span>}<br />{pRole} · {lang === 'pt' && p.org_pt ? p.org_pt : p.org}{sponsor}</span>
                {p.image && (
                  <ZoomFigure src={p.image} alt={pAlt} title={pName} caption={pCap} info={projectInfo(p, p.line)} lang={lang} />
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 14px 16px; margin-top: 30px; }
  .jump-st {
    display: inline-flex; align-items: center; gap: 9px;
    font: 600 0.98rem/1.1 var(--hand); text-decoration: none; color: var(--ink);
    background: #fff; padding: 0.6rem 1rem 0.55rem 0.7rem;
    border: 2px solid var(--c-ink, var(--ink));
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    box-shadow: 0 0 0 4px #fff, 0 0 0 6px color-mix(in srgb, var(--c, #ff7a59) 70%, #ff7a59), 0 12px 18px -10px rgba(11, 45, 107, 0.55);
    transform: rotate(var(--tilt)); transition: transform 0.3s var(--ease-out);
  }
  .jump-st b { display: grid; place-items: center; min-width: 30px; height: 30px; border-radius: 50%; background: var(--c-ink, var(--ink)); color: #fff; font: 700 0.9rem/1 var(--hand); padding: 0 4px; }
  .jump-st:hover { transform: rotate(calc(var(--tilt) * -1)) translateY(-3px) scale(1.03); }
  .jump-st.proj { --c-ink: var(--ink); --c: #ff7a59; }
  .ser { padding-block: clamp(56px, 8vw, 96px); border-bottom: 1.5px solid var(--ink); scroll-margin-top: 80px; }
  .ser-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: 32px 64px; }
  .ser-head { position: sticky; top: 100px; align-self: start; }
  .ser-sym { font: 600 2.2rem/1 var(--hand); color: var(--c-ink); margin: 14px 0 0; display: flex; align-items: baseline; gap: 14px; }
  .mini { position: relative; height: 64px; margin-top: 18px; background: var(--plate); border-radius: 4px; }
  .mini i { position: absolute; top: 8px; bottom: 8px; width: 2px; background: var(--mist-soft); opacity: 0.18; transform: translateX(-50%); }
  .mini i[data-on='1'] { background: var(--c); opacity: 1; width: 3px; }
  .mini i[data-on='1'][data-status='under-review'] { background: repeating-linear-gradient(to bottom, var(--c) 0 7px, transparent 7px 11px); }
  .mini i[data-on='1'][data-status='in-preparation'] { background: repeating-linear-gradient(to bottom, var(--c) 0 3px, transparent 3px 7px); }
  .mini b { position: absolute; bottom: -20px; transform: translateX(-50%); font-size: 0.62rem; font-weight: 400; color: var(--ink-soft); }
  .ser-sym .mono { font-size: 0.72rem; font-weight: 400; color: var(--ink-soft); }
  .ser-head h2 { font: 500 clamp(1.9rem, 3.4vw, 2.7rem)/1.05 var(--hand); }
  .ser-sum { color: var(--ink-soft); margin: 34px 0 0; max-width: 52ch; }
  /* every figure on this page shares one frame: 300 px wide, 16:10 */
  .ser-gallery { display: flex; flex-direction: column; gap: 18px; margin-top: 24px; }
  .ser-wide { margin-bottom: 36px; }
  .ser-list { list-style: none; margin: 0; padding: 0; color: var(--c-ink); }
  .tools { margin-top: 36px; }
  .tools h3 { font: 500 1.4rem/1 var(--hand); margin-bottom: 10px; color: var(--c-ink); }
  .tools ul, .projects ul { list-style: none; margin: 0; padding: 0; }
  .tools li, .projects li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); color: var(--ink-soft); }
  .tools strong, .projects strong { color: var(--ink); font-weight: 600; }
  .projects { padding-block: clamp(56px, 8vw, 96px) 112px; }
  .projects ul { margin-top: 28px; color: var(--ink); }
  .projects li.has-img { grid-template-columns: 96px minmax(0, 1fr) 300px; align-items: start; }
  @media (max-width: 760px) {
    .projects li.has-img { grid-template-columns: 96px minmax(0, 1fr); }
    .projects li.has-img :global(.zf) { grid-column: 1 / -1; }
  }
  @media (max-width: 900px) { .ser-grid { grid-template-columns: 1fr; } .ser-head { position: static; } }
  .trl-tag { font-size: 0.72rem; color: var(--ink-soft); white-space: nowrap; }
</style>

---
/*
 * Teaching · private area on a static site (GitHub Pages has no server).
 * Access control is ENCRYPTION: the catalog (in this page) and every lesson (/teaching/data/<id>.json)
 * are AES-256-GCM ciphertext; the key is unwrapped in the browser from "user:password" (PBKDF2).
 * The session keeps only the unwrapped content key (sessionStorage), never the password.
 */
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { type Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;

const T = lang === 'pt'
  ? { title: 'Ensino', lede: 'Área privada com o material das minhas disciplinas: slides das aulas e apostilas para download.', signin: 'Entrar na área do aluno', user: 'Usuário', pass: 'Senha', show: 'Mostrar senha', enter: 'Entrar', wrong: 'Usuário ou senha incorretos.', out: 'Sair', lock: 'Conteúdo criptografado de ponta a ponta', unlocking: 'Verificando…', lessons: 'aulas', slidesBtn: 'Slides', handoutBtn: 'Apostila', back: 'Voltar às aulas', prev: 'Anterior', next: 'Avançar', full: 'Tela cheia', print: 'Baixar apostila (PDF)', loading: 'Carregando aula…', help: 'Use ← → ou espaço para avançar. F = tela cheia.', choose: 'Escolha a disciplina e a aula' }
  : { title: 'Teaching', lede: 'Private area with my course material: lecture slides and downloadable handouts.', signin: 'Student sign-in', user: 'Username', pass: 'Password', show: 'Show password', enter: 'Sign in', wrong: 'Wrong username or password.', out: 'Sign out', lock: 'End-to-end encrypted content', unlocking: 'Checking…', lessons: 'lessons', slidesBtn: 'Slides', handoutBtn: 'Handout', back: 'Back to lessons', prev: 'Previous', next: 'Next', full: 'Full screen', print: 'Download handout (PDF)', loading: 'Loading lesson…', help: 'Use ← → or space to advance. F = full screen.', choose: 'Choose a course and a lesson' };
---
<Base title={T.title} description={T.lede} current="/teaching/" lang={lang}>
  <PageHead title={T.title} lede={T.lede} />

  <section class="paper teach">
    <div class="wrap">
      <!-- 1 · sign-in -->
      <form class="gate" id="gate" autocomplete="on">
        <h2 class="g-title">{T.signin}</h2>
        <label class="g-field"><span>{T.user}</span><input name="u" autocomplete="username" autocapitalize="none" spellcheck="false" required /></label>
        <label class="g-field"><span>{T.pass}</span>
          <span class="g-pass"><input name="p" type="password" autocomplete="current-password" required /><button type="button" class="g-eye" aria-label={T.show} aria-pressed="false">👁</button></span>
        </label>
        <button class="act solid g-go" type="submit">{T.enter}</button>
        <p class="g-msg" role="alert" aria-live="assertive"></p>
        <p class="g-lock mono">🔒 {T.lock}</p>
      </form>

      <!-- 2 · catalog -->
      <div id="cat" hidden>
        <div class="cat-bar"><h2 class="cat-h">{T.choose}</h2><button type="button" class="act" data-logout>{T.out}</button></div>
        <div id="courses"></div>
      </div>

      <!-- 3 · lesson -->
      <div id="room" hidden>
        <div class="room-bar">
          <button type="button" class="act" id="back">← {T.back}</button>
          <p class="room-title" id="roomTitle"></p>
          <button type="button" class="act solid" id="print">{T.print}</button>
        </div>
        <div class="deck" id="deck" tabindex="0" aria-roledescription="slides">
          <div class="deck-stage" id="stage" aria-live="polite"></div>
          <div class="deck-bar">
            <button type="button" class="db" id="prev" aria-label={T.prev}>←</button>
            <span class="db-count mono"><b id="cur">1</b> / <span id="tot">1</span></span>
            <span class="db-prog"><i id="prog"></i></span>
            <button type="button" class="db" id="next" aria-label={T.next}>→</button>
            <button type="button" class="db" id="full" aria-label={T.full} title={T.full}>⛶</button>
          </div>
          <p class="deck-help">{T.help}</p>
        </div>
        <div id="lesson" class="handout" hidden></div>
      </div>
    </div>
  </section>
  <script type="application/json" id="teach-i18n" set:html={JSON.stringify(T)} />
</Base>

<style>
  .teach { padding-block: clamp(40px, 6vw, 80px) clamp(72px, 9vw, 120px); }
  [hidden] { display: none !important; }

  /* ---------- sign-in: a clean card, centred ---------- */
  .gate { max-width: 440px; margin: 0 auto; display: grid; gap: 16px; padding: 30px 30px 24px; background: #fff; border-radius: 18px; box-shadow: 0 0 0 2.5px #ff7a59, 0 24px 48px -24px rgba(11, 45, 107, 0.5); }
  .g-title { font: 500 1.7rem/1.1 var(--hand); }
  .g-field { display: grid; gap: 6px; font: 600 0.92rem/1.2 var(--sans); color: var(--ink-soft); }
  .g-field input { width: 100%; font: 500 1.05rem/1.2 var(--sans); padding: 0.75em 0.9em; border-radius: 12px; border: 1.5px solid var(--plate-rule); background: var(--paper); color: var(--ink); }
  .g-field input:focus { outline: 2px solid #ff7a59; outline-offset: 1px; border-color: transparent; }
  .g-pass { position: relative; display: block; }
  .g-eye { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: 0; background: transparent; font-size: 1.1rem; cursor: pointer; opacity: 0.6; }
  .g-eye[aria-pressed='true'] { opacity: 1; }
  .g-go { justify-content: center; width: 100%; }
  .g-msg { margin: 0; min-height: 1.2em; color: #c8102e; font-weight: 600; text-align: center; }
  .gate.shake { animation: shake 0.35s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  .g-lock { margin: 0; font-size: 0.68rem; color: var(--ink-soft); text-align: center; }

  /* ---------- catalog: ruled lists, like the rest of the site ---------- */
  .cat-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cat-h { font: 500 clamp(1.6rem, 3vw, 2.2rem)/1.1 var(--hand); }
  #courses :global(.course) { margin-top: 28px; }
  #courses :global(.course-h) { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  #courses :global(.course-h h3) { font: 500 clamp(1.8rem, 3.6vw, 2.6rem)/1 var(--hand); background: url('/images/highlight-coral.svg') 0 95% / 100% 40% no-repeat; padding: 0 0.1em; }
  #courses :global(.course-h p) { margin: 0; color: var(--ink-soft); }
  #courses :global(.lessons) { list-style: none; margin: 18px 0 0; padding-left: 0; color: var(--ink); }
  #courses :global(.les) { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  #courses :global(.les-n) { font: 700 1.5rem/1 var(--hand); color: var(--ink); display: grid; place-items: center; align-content: center; width: 54px; height: 54px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 2px #ff7a59; }
  #courses :global(.les-n small) { display: block; font: 600 0.6rem/1 var(--mono); color: var(--ink-soft); margin-top: 2px; }
  #courses :global(.les-t) { font: 500 1.25rem/1.25 var(--hand); color: var(--ink); margin: 0; }
  #courses :global(.les-s) { margin: 4px 0 0; color: var(--ink-soft); font-size: 0.92rem; }
  #courses :global(.les-tp) { margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  #courses :global(.les-tp span) { font-size: 0.74rem; padding: 3px 8px; border-radius: 99px; background: var(--plate); color: var(--ink); }
  #courses :global(.les-a) { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  #courses :global(.les-a .act) { font-size: 0.9rem; padding: 0.55em 0.9em; }
  @media (max-width: 760px) {
    #courses :global(.les) { grid-template-columns: 54px minmax(0, 1fr); }
    #courses :global(.les-a) { grid-column: 2; justify-content: flex-start; }
  }

  /* ---------- lesson room ---------- */
  .room-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
  .room-title { flex: 1; margin: 0; font: 500 1.2rem/1.2 var(--hand); text-align: center; }
  .deck { position: relative; outline: none; }
  .deck:fullscreen { background: #0b2d6b; display: flex; flex-direction: column; justify-content: center; padding: 2vh 2vw; }
  .deck-stage { position: relative; aspect-ratio: 16 / 9; width: 100%; container-type: inline-size; }
  .deck:fullscreen .deck-stage { width: min(100%, calc((100vh - 90px) * 16 / 9)); margin: 0 auto; }
  .deck-help { margin: 8px 0 0; font-size: 0.8rem; color: var(--ink-soft); text-align: center; }
  .deck:fullscreen .deck-help { display: none; }
  .deck-stage :global(.deck-slides) { position: absolute; inset: 0; }
  .deck-stage :global(.slide) {
    position: absolute; inset: 0; display: none; flex-direction: column;
    padding: 4.6cqw 6cqw 4.2cqw; background: #fff; color: #0b2d6b; border-radius: 1.6cqw; overflow: hidden;
    box-shadow: 0 0 0 0.45cqw #ff7a59, 0 3cqw 5cqw -2.5cqw rgba(11, 45, 107, 0.5);
    font-size: 2.05cqw; line-height: 1.45;
  }
  .deck-stage :global(.slide.on) { display: flex; animation: slide-in 0.35s var(--ease-out); }
  @keyframes slide-in { from { opacity: 0; transform: translateX(1.5cqw); } }
  .deck-stage :global(.slide::after) { content: attr(data-n); position: absolute; right: 3cqw; bottom: 2cqw; font: 600 1.2cqw/1 var(--mono); color: #4d5b7c; }
  .deck-stage :global(.slide::before) { content: attr(data-foot); position: absolute; left: 6cqw; bottom: 2cqw; font: 500 1.15cqw/1 var(--sans); color: #4d5b7c; }
  .deck-stage :global(.s-title) { font: 500 3.8cqw/1.05 var(--hand); margin: 0 0 2cqw; padding-bottom: 1.1cqw; background: url('/images/highlight-coral.svg') 0 100% / 30cqw 1.1cqw no-repeat; }
  .deck-stage :global(.s-body) { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 1.5cqw; min-height: 0; }
  .deck-stage :global(.cover), .deck-stage :global(.section) { background: #0b2d6b; color: #fff; }
  .deck-stage :global(.cover .s-body), .deck-stage :global(.section .s-body) { align-items: flex-start; }
  .deck-stage :global(.cover h1) { font: 500 6.4cqw/0.98 var(--hand); color: #fff; margin: 0; background: url('/images/highlight-coral.svg') 0 92% / 100% 40% no-repeat; }
  .deck-stage :global(.cover::before), .deck-stage :global(.cover::after), .deck-stage :global(.section::before), .deck-stage :global(.section::after) { color: #b9c7e4; }
  .deck-stage :global(.s-kicker) { font-size: 1.3cqw; letter-spacing: 0.14em; text-transform: uppercase; color: #ffb3a0; margin: 0; }
  .deck-stage :global(.s-sub) { font: 500 2.2cqw/1.2 var(--hand); margin: 1.5cqw 0 0; }
  .deck-stage :global(.s-base) { font-size: 1.4cqw; color: #b9c7e4; margin: 0; }
  .deck-stage :global(.sec-n) { font: 700 9cqw/1 var(--mono); color: #ff7a59; margin: 0; }
  .deck-stage :global(.sec-t) { font: 500 5.4cqw/1 var(--hand); color: #fff; margin: 0; }
  .deck-stage :global(.sec-l) { font-size: 2.1cqw; color: #dbe7f6; margin: 1cqw 0 0; max-width: 70cqw; }
  .deck-stage :global(.s-agenda) { font: 500 2.5cqw/1.55 var(--hand); padding-left: 3.5cqw; margin: 0; }
  .deck-stage :global(.s-agenda li::marker) { color: #ff7a59; font-weight: 700; }
  .deck-stage :global(.s-list) { margin: 0; padding-left: 2.6cqw; }
  .deck-stage :global(.s-list li) { margin: 0.5cqw 0; }
  .deck-stage :global(.s-list li::marker) { color: #ff7a59; }
  .deck-stage :global(p) { margin: 0; }
  .deck-stage :global(.s-center) { text-align: center; }
  .deck-stage :global(.s-split) { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqw; align-items: center; }
  .deck-stage :global(.s-fig) { margin: 0; }
  .deck-stage :global(.s-fig svg) { width: 100%; height: auto; max-height: 30cqw; display: block; font-family: var(--sans); }
  .deck-stage :global(.s-fig figcaption) { font-size: 1.3cqw; color: #4d5b7c; margin-top: 0.6cqw; text-align: center; }
  .deck-stage :global(.k-def) { background: #f1f5fc; border-radius: 1.2cqw; padding: 1.4cqw 2cqw; box-shadow: inset 0 0 0 0.15cqw #b7cdec; }
  .deck-stage :global(.k-def b) { font: 600 2.1cqw/1.2 var(--hand); color: #0b2d6b; }
  .deck-stage :global(.k-def p) { margin: 0.5cqw 0 0; }
  .deck-stage :global(.k-idea) { align-self: flex-start; font: 600 2.3cqw/1.3 var(--hand); padding: 0.8cqw 2cqw; background: url('/images/highlight-coral.svg') center / 100% 100% no-repeat; }
  .deck-stage :global(.k-warn), .deck-stage :global(.k-ask) { border-radius: 1.2cqw; padding: 1.2cqw 2cqw; }
  .deck-stage :global(.k-warn) { background: #fff1ee; box-shadow: inset 0 0 0 0.15cqw #ffb3a0; }
  .deck-stage :global(.k-ask) { background: #0b2d6b; color: #fff; }
  .deck-stage :global(.k-warn b), .deck-stage :global(.k-ask b) { font: 700 1.3cqw/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .deck-stage :global(.k-warn b) { color: #c8102e; }
  .deck-stage :global(.k-ask b) { color: #ffb3a0; }
  .deck-stage :global(.k-warn p), .deck-stage :global(.k-ask p) { margin: 0.5cqw 0 0; }
  .deck-stage :global(.k-steps) { margin: 0; padding-left: 3cqw; display: grid; gap: 0.8cqw; }
  .deck-stage :global(.k-steps li::marker) { color: #ff7a59; font-weight: 700; }
  .deck-stage :global(.s-answer) { align-self: center; padding: 1cqw 2.4cqw; font: 600 2.2cqw/1.3 var(--hand); background: url('/images/highlight-coral.svg') center / 100% 100% no-repeat; }
  .deck-stage :global(.s-src) { font-size: 1.15cqw; color: #4d5b7c; }
  .deck-stage :global(table) { width: 100%; border-collapse: collapse; font-size: 1.8cqw; }
  .deck-stage :global(th), .deck-stage :global(td) { padding: 0.6cqw 1.1cqw; border-bottom: 0.12cqw solid #dbe7f6; text-align: left; }
  .deck-stage :global(th) { background: #0b2d6b; color: #fff; font: 600 1.6cqw/1.2 var(--hand); }
  .deck-stage :global(.eq) { position: relative; margin: 0; padding: 1.1cqw 7cqw 1.1cqw 2cqw; background: #f8fafd; border: 0.12cqw solid #dbe7f6; border-radius: 1.2cqw; font-size: 1.15em; }
  .deck-stage :global(.eq .katex-display) { margin: 0; }
  .deck-stage :global(.eq-tag) { position: absolute; right: 2cqw; top: 50%; transform: translateY(-50%); font-size: 1.3cqw; color: #4d5b7c; }
  .deck-stage :global(.calc) { padding: 2cqw; background: #0b2d6b; color: #fff; border-radius: 1.4cqw; box-shadow: 0 0 0 0.3cqw #ff7a59; font-size: 1.7cqw; }
  .deck-stage :global(.calc input) { width: 100%; accent-color: #ff7a59; margin: 1cqw 0; }
  .deck-stage :global(.calc dl) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1cqw; margin: 0; }
  .deck-stage :global(.calc dl div) { background: rgba(255, 255, 255, 0.1); border-radius: 0.8cqw; padding: 0.8cqw; }
  .deck-stage :global(.calc dt) { font-size: 1.2cqw; opacity: 0.85; }
  .deck-stage :global(.calc dd) { margin: 0.3cqw 0 0; font: 700 2cqw/1.1 var(--sans); }
  /* progressive reveal */
  .deck-stage :global(.frag) { opacity: 0; transform: translateY(0.6cqw); transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out); }
  .deck-stage :global(.frag.shown) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .deck-stage :global(.slide.on) { animation: none; } .deck-stage :global(.frag) { transition: none; } }

  .deck-bar { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
  .deck:fullscreen .deck-bar { width: min(100%, calc((100vh - 90px) * 16 / 9)); margin: 14px auto 0; color: #fff; }
  .db { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid #ff7a59; background: var(--ink); color: #fff; font: 700 1.1rem/1 var(--sans); cursor: pointer; }
  .db:disabled { opacity: 0.35; cursor: default; }
  .db-count { font-size: 0.85rem; min-width: 64px; text-align: center; }
  .db-prog { flex: 1; height: 6px; border-radius: 99px; background: var(--plate); overflow: hidden; }
  .db-prog i { display: block; height: 100%; width: 0; background: #ff7a59; transition: width 0.3s var(--ease-out); }

  /* ---------- handout (printable "apostila") ---------- */
  #lesson :global(.lesson) { max-width: 920px; color: var(--ink); }
  #lesson :global(.l-kicker) { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0; }
  #lesson :global(h1) { font: 500 clamp(2rem, 4.6vw, 3.2rem)/1 var(--hand); margin: 8px 0 12px; }
  #lesson :global(.l-lede) { font-size: 1.1rem; color: var(--ink-soft); }
  #lesson :global(.l-toc) { margin: 18px 0 0; padding: 16px 22px 16px 42px; background: var(--plate); border-radius: 14px; columns: 2; column-gap: 32px; }
  #lesson :global(section) { padding-top: 36px; }
  #lesson :global(h2) { font: 500 1.8rem/1.1 var(--hand); padding-bottom: 8px; border-bottom: 2px solid var(--plate-rule); margin-bottom: 12px; display: flex; gap: 10px; align-items: baseline; }
  #lesson :global(h2 .n) { font-size: 0.75rem; color: #fff; background: var(--ink); border-radius: 99px; padding: 4px 9px; }
  #lesson :global(h3) { font: 600 1.15rem/1.3 var(--hand); }
  #lesson :global(p), #lesson :global(li) { line-height: 1.7; }
  #lesson :global(.eq) { position: relative; margin: 14px 0; padding: 14px 70px 14px 16px; background: #fff; border: 1px solid var(--plate-rule); border-radius: 12px; overflow-x: auto; }
  #lesson :global(.eq .katex-display) { margin: 0; }
  #lesson :global(.eq-tag) { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: var(--ink-soft); }
  #lesson :global(.l-fig) { margin: 18px 0; padding: 12px; background: #fff; border-radius: 12px; box-shadow: 0 0 0 2px #ff7a59; }
  #lesson :global(.l-fig svg) { width: 100%; height: auto; display: block; max-height: 380px; }
  #lesson :global(.l-fig figcaption) { font-size: 0.88rem; color: var(--ink-soft); margin-top: 6px; }
  #lesson :global(.l-note) { margin: 16px 0; padding: 12px 16px; background: var(--plate); border-radius: 12px; }
  #lesson :global(.ex) { margin: 18px 0; padding: 18px 20px; background: #fff; border-radius: 14px; border: 1.5px solid var(--plate-rule); }
  #lesson :global(.ans) { margin: 10px 0 0; padding: 8px 14px; background: url('/images/highlight-coral.svg') center / 100% 100% no-repeat; font-weight: 600; }
  #lesson :global(table) { border-collapse: collapse; width: 100%; background: #fff; font-size: 0.92rem; }
  #lesson :global(th), #lesson :global(td) { padding: 8px 10px; border-bottom: 1px solid var(--rule); text-align: left; }
  #lesson :global(th) { background: var(--ink); color: #fff; }
  #lesson :global(.l-ref) { margin-top: 40px; padding-top: 14px; border-top: 2px solid var(--plate-rule); font-size: 0.9rem; color: var(--ink-soft); }
  @media print {
    :global(body > *:not(main)), :global(.ph), .gate, #cat, .deck, .room-bar { display: none !important; }
    .teach { padding: 0 !important; background: #fff !important; }
    #lesson { display: block !important; }
    #lesson :global(.l-fig), #lesson :global(.eq), #lesson :global(.ex) { break-inside: avoid; box-shadow: none !important; }
  }
</style>

<script>
  /* encrypted bundle produced locally by `npm run teaching` (scripts/build-teaching.ts) */
  let V: any = null;
  const vaultReady = fetch('/teaching/vault.json').then((r) => r.json()).then((v) => (V = v));
  const L = JSON.parse(document.getElementById('teach-i18n')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const gate = $('gate') as HTMLFormElement, cat = $('cat'), room = $('room');
  const msg = gate.querySelector<HTMLElement>('.g-msg')!, go = gate.querySelector<HTMLButtonElement>('.g-go')!;
  const enc = new TextEncoder();
  const unb64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
  const b64 = (a: ArrayBuffer) => btoa(String.fromCharCode(...new Uint8Array(a)));
  const SK = 'eba-teach-key';
  let key: CryptoKey | null = null;

  async function unwrap(user: string, pass: string) {
    await vaultReady;
    const u = user.trim().toLowerCase();
    const h = new Uint8Array(await crypto.subtle.digest('SHA-256', enc.encode(u)));
    const id = [...h].map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, 16);
    const e = V.keyring[id]; if (!e) throw new Error('user');
    const base = await crypto.subtle.importKey('raw', enc.encode(`${u}:${pass}`), 'PBKDF2', false, ['deriveKey']);
    const kek = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: unb64(e.salt), iterations: V.iter, hash: 'SHA-256' }, base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
    return crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(e.iv) }, kek, unb64(e.ct));
  }
  const importCK = (raw: ArrayBuffer | Uint8Array) => crypto.subtle.importKey('raw', raw, 'AES-GCM', false, ['decrypt']);
  async function openBox(box: { iv: string; ct: string }) {
    const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(box.iv) }, key!, unb64(box.ct));
    return JSON.parse(new TextDecoder().decode(pt));
  }

  /* ---------- catalog ---------- */
  async function showCatalog() {
    await vaultReady;
    const courses = await openBox(V.catalog);
    $('courses').innerHTML = courses.map((c: any) => `
      <section class="course"><div class="course-h"><h3>${c.title}</h3><p>${c.subtitle} · ${c.lessons.length} ${L.lessons}</p></div>
      <ol class="lessons ticked">${c.lessons.map((l: any) => `
        <li class="les"><span class="les-n">${l.num}<small>${l.code}</small></span>
          <div><p class="les-t">${l.title}</p><p class="les-s">${l.summary}</p>
          <p class="les-tp">${l.topics.map((t: string) => `<span>${t}</span>`).join('')}</p></div>
          <div class="les-a"><button class="act solid" data-open="${l.id}" data-mode="slides">▶ ${L.slidesBtn} · ${l.slides}</button>
          <button class="act" data-open="${l.id}" data-mode="handout">${L.handoutBtn}</button></div></li>`).join('')}</ol></section>`).join('');
    gate.hidden = true; room.hidden = true; cat.hidden = false;
  }
  $('courses').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-open]');
    if (b) openLesson(b.dataset.open!, b.dataset.mode as 'slides' | 'handout');
  });

  /* ---------- lesson ---------- */
  const stage = $('stage'), lesson = $('lesson');
  let slides: HTMLElement[] = [], cur = 0, frags: HTMLElement[] = [], fi = 0;
  async function openLesson(id: string, mode: 'slides' | 'handout') {
    $('roomTitle').textContent = L.loading;
    cat.hidden = true; room.hidden = false;
    const box = await (await fetch(`/teaching/data/${id}.json`)).json();
    const data = await openBox(box);
    $('roomTitle').textContent = `Aula ${data.num} · ${data.title}`;
    stage.innerHTML = `<div class="deck-slides">${data.slides.join('')}</div>`;
    lesson.innerHTML = data.handout;
    slides = [...stage.querySelectorAll<HTMLElement>('.slide')];
    slides.forEach((s, k) => { s.dataset.n = `${k + 1}`; s.dataset.foot = `Aula ${data.num} · ${data.title}`; });
    $('tot').textContent = String(slides.length);
    window.scrollTo({ top: room.getBoundingClientRect().top + scrollY - 90 });
    if (mode === 'handout') { $('deck').hidden = true; lesson.hidden = false; }
    else { $('deck').hidden = false; lesson.hidden = true; show(0); $('deck').focus(); }
    wireCalculator(stage);
  }
  function show(i: number, atEnd = false) {
    if (!slides.length) return;
    cur = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, k) => s.classList.toggle('on', k === cur));
    frags = [...slides[cur].querySelectorAll<HTMLElement>('.frag')];
    fi = atEnd ? frags.length : 0;
    frags.forEach((f, k) => f.classList.toggle('shown', k < fi));
    $('cur').textContent = String(cur + 1);
    ($('prog') as HTMLElement).style.width = `${((cur + 1) / slides.length) * 100}%`;
    ($('prev') as HTMLButtonElement).disabled = cur === 0;
  }
  function next() { if (fi < frags.length) frags[fi++].classList.add('shown'); else if (cur < slides.length - 1) show(cur + 1); }
  function prev() { if (fi > 0) frags[--fi].classList.remove('shown'); else if (cur > 0) show(cur - 1, true); }
  $('next').addEventListener('click', next);
  $('prev').addEventListener('click', prev);
  $('full').addEventListener('click', () => { if (document.fullscreenElement) document.exitFullscreen(); else $('deck').requestFullscreen?.(); });
  $('deck').addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).tagName === 'INPUT') return;
    if (['ArrowRight', 'PageDown', ' ', 'Enter'].includes(e.key)) { e.preventDefault(); next(); }
    if (['ArrowLeft', 'PageUp', 'Backspace'].includes(e.key)) { e.preventDefault(); prev(); }
    if (e.key === 'Home') show(0);
    if (e.key === 'End') show(slides.length - 1, true);
    if (e.key.toLowerCase() === 'f') $('full').click();
  });
  let tx = 0;
  stage.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 50) (dx < 0 ? next : prev)(); });
  stage.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('input,button,a,label')) next(); });
  $('print').addEventListener('click', () => { const was = lesson.hidden; lesson.hidden = false; window.print(); lesson.hidden = was; });
  $('back').addEventListener('click', () => { stage.innerHTML = ''; lesson.innerHTML = ''; room.hidden = true; cat.hidden = false; });

  /* ---------- sign-in / session ---------- */
  gate.querySelector('.g-eye')!.addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement, i = gate.querySelector<HTMLInputElement>('input[name=p]')!;
    const on = i.type === 'password'; i.type = on ? 'text' : 'password'; b.setAttribute('aria-pressed', String(on));
  });
  gate.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(gate);
    msg.textContent = ''; go.disabled = true; go.textContent = L.unlocking;
    try {
      const raw = await unwrap(String(fd.get('u')), String(fd.get('p')));
      key = await importCK(raw);
      try { sessionStorage.setItem(SK, b64(raw)); } catch {}
      await showCatalog();
    } catch {
      msg.textContent = L.wrong; gate.classList.remove('shake'); void gate.offsetWidth; gate.classList.add('shake');
    } finally { go.disabled = false; go.textContent = L.enter; }
  });
  document.querySelectorAll('[data-logout]').forEach((b) => b.addEventListener('click', () => {
    try { sessionStorage.removeItem(SK); } catch {}
    key = null; $('courses').innerHTML = ''; cat.hidden = true; room.hidden = true; gate.hidden = false; gate.reset();
  }));
  (async () => {
    try {
      const s = sessionStorage.getItem(SK);
      if (s) { key = await importCK(unb64(s)); await showCatalog(); }
    } catch { try { sessionStorage.removeItem(SK); } catch {} }
  })();

  /* interactive electrolyzer calculator used inside some slides */
  function wireCalculator(scope: HTMLElement) {
    scope.querySelectorAll<HTMLElement>('[data-calc="cell"]').forEach((box) => {
      const input = box.querySelector<HTMLInputElement>('input')!;
      const out = (k: string) => box.querySelector<HTMLElement>(`[data-out="${k}"]`);
      const F = 96485, dH = 285.8, fmt = (x: number, d = 1) => x.toFixed(d).replace('.', ',').replace('-', '−');
      const upd = () => {
        const U = Number(input.value), W = (2 * F * U) / 1000, Q = -W + dH, tn = (dH * 1000) / (2 * F);
        out('U') && (out('U')!.textContent = fmt(U, 2)); out('W') && (out('W')!.textContent = fmt(W));
        out('Q') && (out('Q')!.textContent = fmt(Q)); out('eta') && (out('eta')!.textContent = fmt((dH / W) * 100));
        out('msg') && (out('msg')!.textContent = Math.abs(U - tn) < 0.01 ? 'Tensão termoneutra: Q = 0.' : U > tn ? `Acima de ${fmt(tn, 2)} V: a célula rejeita calor.` : `Abaixo de ${fmt(tn, 2)} V: a célula precisa receber calor.`);
      };
      input.addEventListener('input', upd); upd();
    });
  }
</script>

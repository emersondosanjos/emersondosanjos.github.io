---
/*
 * Teaching · private area on a static site (GitHub Pages has no server).
 * Access control is ENCRYPTION: the catalog (in this page) and every lesson (/teaching/data/<id>.json)
 * are AES-256-GCM ciphertext; the key is unwrapped in the browser from "user:password" (PBKDF2).
 * The session keeps only the unwrapped content key (sessionStorage), never the password.
 */
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { type Lang } from '../lib/i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;

const T = lang === 'pt'
  ? {
      title: 'Ensino',
      lede: 'Área privada com o material das minhas disciplinas: slides em formato 16:9 com simuladores interativos, apostilas para impressão e guias de preparação para provas dissertativas.',
      signin: 'Entrar na área do aluno',
      user: 'Usuário',
      pass: 'Senha',
      show: 'Mostrar senha',
      enter: 'Entrar',
      wrong: 'Usuário ou senha incorretos.',
      out: 'Sair',
      lock: 'Conteúdo criptografado de ponta a ponta',
      unlocking: 'Verificando…',
      lessons: 'aulas',
      slidesBtn: 'Slides',
      handoutBtn: 'Apostila',
      disserteBtn: 'Disserte sobre…',
      modeSlides: 'Slides 16:9',
      modeHandout: 'Apostila',
      modeDisserte: 'Disserte sobre…',
      back: 'Voltar às disciplinas',
      prev: 'Anterior',
      next: 'Avançar',
      full: 'Tela cheia',
      fullExit: 'Sair da tela cheia',
      lessonLabel: 'Aula',
      lessonError: 'Não foi possível carregar a aula. Volte à lista e tente novamente.',
      print: 'Baixar apostila (PDF)',
      printHandout: 'Baixar apostila (PDF)',
      printDisserte: 'Baixar guia Disserte (PDF)',
      loading: 'Carregando aula…',
      help: 'Use ← → ou espaço para avançar. F = tela cheia.',
      choose: 'Escolha a disciplina e a aula',
      comingSoon: 'As aulas desta disciplina estão em preparação e serão publicadas em seguida.',
      disserteMissing: 'Guia dissertativo desta aula em atualização.',
      upgradedTag: 'Aula completa',
      copyDone: 'Copiado!',
      savedLocal: 'Salvo no navegador',
      clearedLocal: 'Anotação limpa',
      courseTabsLabel: 'Disciplinas',
      lessonModesLabel: 'Modo da aula',
      localNote: 'Anotação local',
    }
  : {
      title: 'Teaching',
      lede: 'Private area with full course materials: widescreen 16:9 interactive slides, printable workbooks, and professor-exam "Disserte sobre…" guides.',
      signin: 'Student sign-in',
      user: 'Username',
      pass: 'Password',
      show: 'Show password',
      enter: 'Sign in',
      wrong: 'Wrong username or password.',
      out: 'Sign out',
      lock: 'End-to-end encrypted content',
      unlocking: 'Checking…',
      lessons: 'lessons',
      slidesBtn: 'Slides',
      handoutBtn: 'Handout',
      disserteBtn: 'Essay guide',
      modeSlides: '16:9 Slides',
      modeHandout: 'Handout',
      modeDisserte: 'Essay Guide',
      back: 'Back to courses',
      prev: 'Previous',
      next: 'Next',
      full: 'Full screen',
      fullExit: 'Exit full screen',
      lessonLabel: 'Lesson',
      lessonError: 'This lesson could not be loaded. Return to the list and try again.',
      print: 'Download handout (PDF)',
      printHandout: 'Download handout (PDF)',
      printDisserte: 'Download essay guide (PDF)',
      loading: 'Loading lesson…',
      help: 'Use ← → or space to advance. F = full screen.',
      choose: 'Choose a course and a lesson',
      comingSoon: 'Lessons for this course are being prepared and will appear shortly.',
      disserteMissing: 'Professor-exam essay guide for this lesson is being updated.',
      upgradedTag: 'Complete lesson',
      copyDone: 'Copied!',
      savedLocal: 'Saved locally',
      clearedLocal: 'Cleared',
      courseTabsLabel: 'Courses',
      lessonModesLabel: 'Lesson view',
      localNote: 'Local note',
    };
---
<Base title={T.title} description={T.lede} current="/teaching/" lang={lang}>
  <PageHead title={T.title} lede={T.lede} />

  <section class="paper teach">
    <div class="wrap">
      <div class="teaching-author">
        <strong>Emerson Barbosa dos Anjos</strong>
        <span>Doutor em Engenharia Mecânica · COPPE/UFRJ</span>
      </div>
      <!-- 1 · sign-in -->
      <form class="gate" id="gate" autocomplete="on">
        <h2 class="g-title">{T.signin}</h2>
        <label class="g-field"><span>{T.user}</span><input name="u" autocomplete="username" autocapitalize="none" spellcheck="false" required /></label>
        <label class="g-field"><span>{T.pass}</span>
          <span class="g-pass"><input name="p" type="password" autocomplete="current-password" required /><button type="button" class="g-eye" aria-label={T.show} aria-pressed="false"><Icon name="eye" /></button></span>
        </label>
        <button class="act solid g-go" type="submit">{T.enter}</button>
        <p class="g-msg" role="alert" aria-live="assertive"></p>
        <p class="g-lock mono"><Icon name="lock" /> {T.lock}</p>
      </form>

      <!-- 2 · catalog (3 course sticker tabs styled like site header feature buttons) -->
      <div id="cat" hidden>
        <div class="cat-bar"><h2 class="cat-h">{T.choose}</h2><button type="button" class="act" data-logout>{T.out}</button></div>
        <div class="course-tabs" id="courseTabs" role="tablist" aria-label={T.courseTabsLabel}></div>
        <div id="courses"></div>
      </div>

      <!-- 3 · lesson -->
      <div id="room" hidden>
        <div class="room-bar">
          <button type="button" class="act" id="back">← {T.back}</button>
          <div class="room-head">
            <p class="room-title" id="roomTitle"></p>
            <div class="mode-tabs" id="modeTabs" role="tablist" aria-label={T.lessonModesLabel}>
              <button type="button" class="m-tab" role="tab" data-mode-tab="slides" aria-selected="true">{T.modeSlides}</button>
              <button type="button" class="m-tab" role="tab" data-mode-tab="handout" aria-selected="false">{T.modeHandout}</button>
              <button type="button" class="m-tab" role="tab" data-mode-tab="disserte" aria-selected="false">{T.modeDisserte}</button>
            </div>
          </div>
          <button type="button" class="act solid" id="print">{T.print}</button>
        </div>
        <div class="deck" id="deck" tabindex="0" aria-labelledby="roomTitle">
          <div class="presentation-head" id="presentation-head" hidden>
            <p id="presentation-title"></p>
            <button type="button" class="act" id="exit-presentation">{T.fullExit}</button>
          </div>
          <div class="presentation-grid">
            <div class="deck-stage" id="stage" lang="pt-BR" aria-live="polite"></div>
            <div class="deck-bar">
              <button type="button" class="db" id="prev" aria-label={T.prev}><Icon name="chevron-left" /></button>
              <span class="db-count mono"><b id="cur">1</b> / <span id="tot">1</span></span>
              <span class="db-prog" aria-hidden="true"><i id="prog"></i></span>
              <button type="button" class="db" id="next" aria-label={T.next}><Icon name="chevron-right" /></button>
              <button type="button" class="db" id="full" aria-label={T.full} title={T.full}><Icon name="expand" /></button>
            </div>
          </div>
          <p class="deck-help">{T.help}</p>
        </div>
        <div id="lesson" class="handout" hidden></div>
        <div id="disserte-panel" class="handout disserte-view" hidden></div>
      </div>
    </div>
  </section>
  <script type="application/json" id="teach-i18n" set:html={JSON.stringify(T)} />
</Base>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Kalam:wght@300;400;700&display=swap');

  .teach {
    --hand: 'Kalam', 'Bradley Hand', 'Noteworthy', 'Segoe Print', cursive;
    --hand-title: 'Caveat', 'Kalam', 'Bradley Hand', cursive;
    padding-block: clamp(40px, 6vw, 80px) clamp(72px, 9vw, 120px);
  }
  [hidden] { display: none !important; }
  .teaching-author { display: grid; gap: 2px; width: fit-content; margin: 0 auto 28px; color: var(--ink); text-align: center; }
  .teaching-author span { font-size: 0.9rem; color: var(--ink-soft); }
  .g-eye :global(svg), .g-lock :global(svg) { width: 16px; height: 16px; vertical-align: middle; }
  .g-field input[type='password'], .g-pass input { padding-inline-end: 44px; }
  .g-eye { min-width: 40px; min-height: 40px; }

  /* ---------- sign-in ---------- */
  .gate {
    max-width: 440px;
    margin: 0 auto;
    display: grid;
    gap: 16px;
    padding: 30px 30px 24px;
    background: #fff;
    border: 2px solid #0b2d6b;
    border-radius: 16px 10px 16px 10px / 10px 16px 10px 16px;
    box-shadow: 5px 5px 0 #ff7a59, 0 24px 48px -24px rgba(11, 45, 107, 0.45);
  }
  .g-title { font: 500 1.7rem/1.1 var(--sans); }
  .g-field { display: grid; gap: 6px; font: 600 0.92rem/1.2 var(--sans); color: var(--ink-soft); }
  .g-field input { width: 100%; font: 500 1.05rem/1.2 var(--sans); padding: 0.75em 0.9em; border-radius: 10px; border: 1.5px solid var(--plate-rule); background: var(--paper); color: var(--ink); }
  .g-field input:focus { outline: 2px solid #ff7a59; outline-offset: 1px; border-color: transparent; }
  .g-pass { position: relative; display: block; }
  .g-eye { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); border: 0; background: transparent; font-size: 1.1rem; cursor: pointer; opacity: 0.6; }
  .g-eye[aria-pressed='true'] { opacity: 1; }
  .g-go { justify-content: center; width: 100%; }
  .g-msg { margin: 0; min-height: 1.2em; color: #c8102e; font-weight: 600; text-align: center; }
  .gate.shake { animation: shake 0.35s; }
  @keyframes shake { 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  .g-lock { margin: 0; font-size: 0.68rem; color: var(--ink-soft); text-align: center; }

  /* ---------- catalog & 3 taped sticker course tabs ("Eletrolisadores" / "IA para indústria" style) ---------- */
  .cat-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cat-h { font: 500 clamp(1.6rem, 3vw, 2.2rem)/1.1 var(--sans); }
  .course-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 20px;
    margin-top: 22px;
    padding-bottom: 18px;
  }
  .course-tabs :global(.c-tab) {
    --tilt: -1.4deg;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0.72rem 1.2rem 0.68rem;
    font: 700 0.96rem/1.15 var(--sans);
    letter-spacing: 0.01em;
    color: #0b2d6b;
    background: var(--name-highlight, #f6a593);
    border: 2px solid #0b2d6b;
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    transform: rotate(var(--tilt));
    box-shadow: 0 12px 18px -10px rgba(11, 45, 107, 0.55), 3px 3px 0 #0b2d6b;
    cursor: pointer;
    transition: transform 0.32s var(--ease-out), box-shadow 0.32s var(--ease-out), background 0.2s ease, color 0.2s ease;
  }
  .course-tabs :global(.c-tab:nth-child(2)) { --tilt: 1.3deg; background: #dbe7f6; }
  .course-tabs :global(.c-tab:nth-child(3)) { --tilt: -1deg; background: #ffd2c6; }
  .course-tabs :global(.c-tab::before) {
    content: '';
    position: absolute;
    z-index: 2;
    top: -0.62rem;
    right: -0.75rem;
    width: 2.9rem;
    height: 1.05rem;
    background: linear-gradient(180deg, rgba(232, 222, 190, 0.95), rgba(214, 200, 160, 0.82));
    transform: rotate(26deg);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    -webkit-mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
    mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
    pointer-events: none;
  }
  .course-tabs :global(.c-tab:nth-child(2)::before) { left: -0.7rem; right: auto; transform: rotate(-22deg); }
  .course-tabs :global(.c-tab:hover) {
    transform: rotate(calc(var(--tilt) * -0.8)) translateY(-2px);
    box-shadow: 0 16px 22px -12px rgba(11, 45, 107, 0.75), 4px 4px 0 #0b2d6b;
  }
  .course-tabs :global(.c-tab[aria-selected='true']) {
    background: #0b2d6b;
    color: #fff;
    border-color: #ff7a59;
    transform: rotate(0deg) translateY(-2px);
    box-shadow: 0 14px 20px -10px rgba(11, 45, 107, 0.8), 4px 4px 0 #ff7a59;
  }
  .course-tabs :global(.c-tab-count) {
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.72);
    color: #0b2d6b;
  }
  .course-tabs :global(.c-tab[aria-selected='true'] .c-tab-count) {
    background: rgba(255, 122, 89, 0.25);
    color: #ffd2c6;
  }

  #courses :global(.course) { margin-top: 22px; }
  #courses :global(.course-h) { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  #courses :global(.course-h h3) {
    font: 500 clamp(1.8rem, 3.6vw, 2.5rem)/1.05 var(--sans);
    background: linear-gradient(transparent 62%, #f6a593 62% 94%, transparent 94%);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border-radius: 3px;
    padding: 0 0.14em;
  }
  #courses :global(.course-h p) { margin: 0; color: var(--ink-soft); }
  #courses :global(.course-desc) { margin: 8px 0 0; color: var(--ink-soft); max-width: 72ch; font-size: 0.96rem; }
  #courses :global(.course-empty) { margin-top: 20px; padding: 24px 0; border-top: 2px solid var(--ink); color: var(--ink); }
  #courses :global(.lessons) { list-style: none; margin: 18px 0 0; padding-left: 0; color: var(--ink); }
  #courses :global(.les) { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  #courses :global(.les-n) { font: 700 1.45rem/1 var(--sans); color: var(--ink); display: grid; place-items: center; align-content: center; width: 54px; height: 54px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 2px #ff7a59; }
  #courses :global(.les-n small) { display: block; font: 600 0.54rem/1 var(--mono); color: var(--ink-soft); margin-top: 3px; text-transform: uppercase; letter-spacing: 0.04em; }
  #courses :global(.les-t-row) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  #courses :global(.les-t) { font: 500 1.25rem/1.25 var(--sans); color: var(--ink); margin: 0; }
  #courses :global(.les-badge) { font: 700 0.66rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 8px; border-radius: 99px; background: #ffd2c6; color: #0b2d6b; }
  #courses :global(.les-s) { margin: 4px 0 0; color: var(--ink-soft); font-size: 0.92rem; }
  #courses :global(.les-tp) { margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  #courses :global(.les-tp span) { font-size: 0.74rem; padding: 3px 8px; border-radius: 99px; background: var(--plate); color: var(--ink); }
  #courses :global(.les-a) { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  #courses :global(.les-a .act) { font-size: 0.88rem; padding: 0.5em 0.85em; }
  @media (max-width: 820px) {
    #courses :global(.les) { grid-template-columns: 54px minmax(0, 1fr); }
    #courses :global(.les-a) { grid-column: 2; justify-content: flex-start; }
  }

  /* ---------- lesson room ---------- */
  .room-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
  .room-head { flex: 1; display: grid; gap: 8px; justify-items: center; min-width: 240px; }
  .room-title { margin: 0; font: 600 1.15rem/1.2 var(--sans); text-align: center; }
  .mode-tabs { display: inline-flex; flex-wrap: wrap; gap: 8px; }
  .m-tab {
    border: 1.5px solid #0b2d6b;
    background: #fff;
    color: #0b2d6b;
    font: 600 0.84rem/1.2 var(--sans);
    padding: 7px 14px;
    border-radius: 180px 12px 160px 12px / 12px 160px 12px 180px;
    box-shadow: 2px 2px 0 #0b2d6b;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .m-tab[aria-selected='true'] { background: #0b2d6b; color: #fff; border-color: #ff7a59; box-shadow: 3px 3px 0 #ff7a59; transform: translate(-1px, -1px); }
  .m-tab:hover:not([aria-selected='true']) { background: #ffd2c6; }

  .deck { position: relative; --slide-coral: var(--name-highlight, #f6a593); }
  .presentation-grid { display: grid; gap: 14px; max-width: 1240px; margin-inline: auto; min-width: 0; }
  .deck-stage { position: relative; aspect-ratio: 16 / 9; width: 100%; container-type: inline-size; }
  :global(html:has(#deck.presenting)), :global(body:has(#deck.presenting)) { overflow: hidden; }
  .deck.presenting {
    position: fixed;
    z-index: 20;
    inset: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--plate);
    color: var(--ink);
    overflow: hidden;
    overscroll-behavior: contain;
    padding: max(8px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right))
      max(10px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
  }
  .deck.presenting .presentation-grid {
    flex: 1 1 auto;
    min-height: 0;
    align-content: center;
    width: 100%;
    max-width: min(calc(100vw - 32px), max(320px, calc((100dvh - 134px) * 16 / 9)));
    gap: 8px;
  }
  .presentation-head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-block: 2px;
    background: var(--plate);
  }
  .presentation-head p {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .presentation-head .act { flex: none; min-height: 34px; color: var(--ink); background: var(--paper); font-size: 0.82rem; padding: 4px 12px; }
  .deck.presenting .deck-bar { flex: 0 0 auto; padding-block: 2px; background: var(--plate); }
  .deck.presenting .db { width: 36px; height: 36px; }
  .deck.presenting #full { display: none; }
  .deck-help { margin: 6px 0 0; font-size: 0.8rem; color: var(--ink-soft); text-align: center; }
  .deck.presenting .deck-help { display: none; }
  .deck-stage :global(.deck-slides) { position: absolute; inset: 0; }
  .deck-stage :global(.slide) {
    position: absolute; inset: 0; display: none; flex-direction: column;
    padding: 2.1cqw 3.6cqw 1.35cqw; background: var(--paper); color: var(--ink); border: 3px solid var(--slide-coral); border-radius: 12px; overflow-x: hidden; overflow-y: auto;
    box-shadow: 0 2cqw 4cqw -2.5cqw rgba(11, 45, 107, 0.5);
    font-size: 1.56cqw; line-height: 1.36;
  }
  .deck-stage :global(.slide.on) { display: flex; animation: slide-in 0.35s var(--ease-out); }
  .deck-stage :global(.slide:has(.cycle-sim, .dyn-ex, .ai-lab, .sys-grid)) { padding: 1.8cqw 3.2cqw 1.25cqw; }
  @keyframes slide-in { from { opacity: 0; transform: translateX(1.5cqw); } }
  .deck-stage :global(.s-title) { font: 550 2.72cqw/1.08 var(--sans); margin: 0 0 0.95cqw; padding-bottom: 0.55cqw; border-bottom: 2px solid var(--slide-coral); }
  .deck-stage :global(.slide:has(.cycle-sim, .dyn-ex, .ai-lab) .s-title) { font-size: 2.4cqw; margin-bottom: 0.75cqw; padding-bottom: 0.45cqw; }
  .deck-stage :global(.s-body) { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: safe center; gap: 0.95cqw; }
  .deck-stage :global(.slide:has(.cycle-sim, .dyn-ex, .sys-grid) .s-body) { justify-content: safe center; gap: 0.85cqw; }
  .deck-stage :global(.cover), .deck-stage :global(.section) { background: #0b2d6b; color: #fff; }
  .deck-stage :global(.cover .s-body), .deck-stage :global(.section .s-body) { align-items: flex-start; }
  .deck-stage :global(.cover h1) { font: 550 5.1cqw/1.02 var(--sans); color: #fff; margin: 0; max-width: 24ch; }
  .deck-stage :global(.s-kicker) { font-size: 1.25cqw; letter-spacing: 0.14em; text-transform: uppercase; color: #ffb3a0; margin: 0; }
  .deck-stage :global(.s-sub) { font: 600 2.15cqw/1.2 var(--sans); margin: 1.2cqw 0 0; color: #fff; }
  .deck-stage :global(.s-author-role) { color: #dbe7f6; font-size: 1.6cqw; margin: 0.2cqw 0 0; }
  .deck-stage :global(.s-base) { font-size: 1.28cqw; color: #b9c7e4; margin: 0.75cqw 0 0; }
  .deck-stage :global(.sec-n) { font: 700 8cqw/1 var(--mono); color: var(--slide-coral); margin: 0; }
  .deck-stage :global(.sec-t) { font: 550 4.6cqw/1.04 var(--sans); color: #fff; margin: 0; }
  .deck-stage :global(.sec-l) { font-size: 1.85cqw; color: #dbe7f6; margin: 0.85cqw 0 0; max-width: 70cqw; }

  /* Persistent widescreen 16:9 slide footer */
  .deck-stage :global(.s-chrome) {
    flex: 0 0 auto;
    margin-top: 0.85cqw;
    padding-top: 0.5cqw;
    border-top: 1px solid #b7cdec;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4cqw;
    font-size: 1.02cqw;
    line-height: 1.2;
    color: #4d5b7c;
  }
  .deck-stage :global(.s-chrome-author) { font-weight: 600; color: #0b2d6b; }
  .deck-stage :global(.s-chrome-course) { text-align: center; }
  .deck-stage :global(.s-chrome-num) { font-weight: 700; color: #0b2d6b; white-space: nowrap; }
  .deck-stage :global(:is(.cover, .section) .s-chrome) { border-top-color: rgba(219, 231, 246, 0.28); color: #b9c7e4; }
  .deck-stage :global(:is(.cover, .section) .s-chrome-author),
  .deck-stage :global(:is(.cover, .section) .s-chrome-num) { color: #ffb3a0; }

  .deck-stage :global(.s-agenda) { font: 500 1.82cqw/1.4 var(--sans); padding-left: 3cqw; margin: 0; }
  .deck-stage :global(.s-agenda li::marker) { color: var(--slide-coral); font-weight: 700; }
  .deck-stage :global(.s-list) { margin: 0; padding-left: 2.3cqw; }
  .deck-stage :global(.s-list li) { margin: 0.35cqw 0; }
  .deck-stage :global(.s-list li::marker) { color: var(--slide-coral); }
  .deck-stage :global(p) { margin: 0; }
  .deck-stage :global(.s-center) { text-align: center; }
  :global(.nw) { white-space: nowrap; }
  .deck-stage :global(.s-split) { display: grid; grid-template-columns: 1fr 1fr; gap: 2cqw; align-items: stretch; }
  .deck-stage :global(.s-split > div) { display: flex; flex-direction: column; justify-content: center; gap: 0.95cqw; min-width: 0; }
  .deck-stage :global(.s-split > div > :only-child) { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; }
  .deck-stage :global(.s-fig) {
    margin: 0;
    padding: 0.65cqw;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 0 0 2px #ff7a59, 0 10px 18px -12px rgba(11, 45, 107, 0.42);
  }
  .deck-stage :global(.s-fig.taped::before) {
    top: -1.15cqw;
    right: 0.9cqw;
    width: 6.4cqw;
    height: 2.05cqw;
    transform: rotate(19deg);
    background: linear-gradient(180deg, rgba(236, 224, 186, 0.96), rgba(214, 198, 152, 0.88));
    box-shadow: 0 2px 5px rgba(11, 45, 107, 0.28);
    pointer-events: none;
  }
  .deck-stage :global(.s-fig svg) { width: 100%; height: auto; max-height: 31cqw; display: block; font-family: var(--sans); }
  .deck-stage :global(.s-fig.compact svg) { max-height: 24.5cqw; }
  .deck-stage :global(.system-diagram) { width: min(100%, 48rem); align-self: center; }
  .deck-stage :global(.system-diagram svg) { max-height: min(24cqw, 255px); }
  .deck-stage :global(.s-fig figcaption) { font-size: 1.14cqw; color: #4d5b7c; margin-top: 0.42cqw; text-align: center; }

  /* Symmetric organic tactile slide callouts (zero rectangular AI boxes) */
  .deck-stage :global(.k-def),
  .deck-stage :global(.k-warn) {
    display: flex;
    flex-direction: column;
    gap: 0.45cqw;
    background: #fff;
    border: 2px solid #0b2d6b;
    border-radius: 16px 10px 16px 10px / 10px 16px 10px 16px;
    padding: 1cqw 1.4cqw;
    box-shadow: 0.3cqw 0.3cqw 0 #0b2d6b;
  }
  .deck-stage :global(.k-def b) { font: 650 1.62cqw/1.2 var(--sans); color: #0b2d6b; }
  .deck-stage :global(.k-def p) { margin: 0; }
  .deck-stage :global(.k-idea) {
    align-self: stretch;
    width: 100%;
    font: 600 1.56cqw/1.32 var(--sans);
    padding: 0.7cqw 1.35cqw;
    background: #ffd2c6;
    border-left: 0.42cqw solid #ff7a59;
    border-radius: 0.55cqw;
    color: #0b2d6b;
  }
  .deck-stage :global(.k-warn) { background: #fff4f1; border-color: #ff7a59; box-shadow: 0.3cqw 0.3cqw 0 #ff7a59; gap: 0.38cqw; padding: 0.9cqw 1.35cqw; }
  .deck-stage :global(.k-warn b) { font: 700 1.14cqw/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: #b42323; }
  .deck-stage :global(.k-warn p) { margin: 0; }
  .deck-stage :global(.k-ask.brush) {
    padding: 2.2cqw 6%;
    transform: rotate(-0.4deg);
    filter: drop-shadow(0 0.8cqw 1cqw rgba(11, 45, 107, 0.16));
  }
  .deck-stage :global(.k-ask.brush b) { font: 700 1.18cqw/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: #ffb3a0 !important; }
  .deck-stage :global(.k-ask.brush p) { margin: 0.45cqw 0 0; font-size: 1.65cqw; }

  .deck-stage :global(.k-steps) { margin: 0; padding-left: 2.6cqw; display: grid; gap: 0.6cqw; }
  .deck-stage :global(.k-steps li::marker) { color: var(--slide-coral); font-weight: 700; }
  .deck-stage :global(.s-answer) { align-self: center; padding: 0.8cqw 2cqw; font: 600 1.85cqw/1.3 var(--sans); background: #ffd2c6; border: 2px solid #0b2d6b; border-radius: 16px 10px 16px 10px / 10px 16px 10px 16px; }
  .deck-stage :global(.s-src) { font-size: 1.1cqw; color: #4d5b7c; }
  .deck-stage :global(table) { width: 100%; border-collapse: collapse; font-size: 1.38cqw; }
  .deck-stage :global(th), .deck-stage :global(td) { padding: 0.42cqw 0.78cqw; border-bottom: 0.12cqw solid #dbe7f6; text-align: left; }
  .deck-stage :global(th) { background: #0b2d6b; color: #fff; font: 600 1.32cqw/1.2 var(--sans); }
  .deck-stage :global(.eq) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85cqw;
    margin: 0;
    padding: 0.55cqw 1.05cqw;
    background: #fff;
    border: 0.12cqw solid #b7cdec;
    border-radius: 16px 10px 16px 10px / 10px 16px 10px 16px;
    font-size: 0.92em;
  }
  .deck-stage :global(.eq .katex-display) {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .deck-stage :global(.eq-tag) {
    position: static;
    transform: none;
    flex: 0 0 auto;
    font-size: 0.98cqw;
    color: #4d5b7c;
    white-space: nowrap;
  }

  /* ---------- Interactive 3-System Animated Sticker Cards ---------- */
  :global(.sys-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.8cqw;
    align-items: stretch;
  }
  :global(.sys-sticker) {
    --tilt: 0deg;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55cqw;
    padding: 0.85cqw 0.95cqw 0.95cqw;
    background: #fff;
    border-radius: 14px;
    transform: rotate(var(--tilt));
    box-shadow: 0 0 0 2.5px #ff7a59, 0 12px 22px -12px rgba(11, 45, 107, 0.45), 0 3px 0 3px rgba(11, 45, 107, 0.1);
    transition: transform 0.34s var(--ease-out), box-shadow 0.34s var(--ease-out);
    outline: none;
  }
  :global(.sys-sticker::before) {
    content: '';
    position: absolute;
    z-index: 2;
    top: -0.75rem;
    right: 0.85rem;
    width: 4.2rem;
    height: 1.45rem;
    background: linear-gradient(180deg, rgba(236, 224, 186, 0.96), rgba(214, 198, 152, 0.88));
    transform: rotate(16deg);
    box-shadow: 0 2px 5px rgba(11, 45, 107, 0.25);
    -webkit-mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
    mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
  }
  .deck-stage :global(.sys-sticker::before) {
    top: -0.95cqw;
    right: 0.9cqw;
    width: 5.8cqw;
    height: 1.9cqw;
    transform: rotate(17deg);
  }
  :global(.sys-sticker:hover),
  :global(.sys-sticker:focus-visible) {
    transform: rotate(-0.7deg) translateY(-6px) scale(1.02);
    box-shadow: 0 0 0 3px #0b2d6b, 0 22px 34px -14px rgba(11, 45, 107, 0.65), 4px 4px 0 #ff7a59;
  }
  :global(.sys-sticker svg) { width: 100%; height: auto; display: block; border-radius: 8px; background: #f8fafd; }
  :global(.sys-sticker h3) { margin: 0; font: 700 1.05rem/1.2 var(--sans); color: #0b2d6b; text-align: center; }
  :global(.sys-sticker p) { margin: 0; font-size: 0.88rem; line-height: 1.45; color: #3f4a66; }
  .deck-stage :global(.sys-sticker h3) { font-size: 1.48cqw; }
  .deck-stage :global(.sys-sticker p) { font-size: 1.18cqw; line-height: 1.35; }
  .deck-stage :global(.sys-sticker svg) { max-height: 21.5cqw; }
  .handout :global(.sys-grid) { gap: 22px; margin: 20px 0; }
  @media (max-width: 820px) { .handout :global(.sys-grid) { grid-template-columns: 1fr; } }

  /* Rich internal + boundary SVG animations inside system stickers */
  :global(.anim-piston) { animation: piston-bob 3.6s ease-in-out infinite; }
  :global(.anim-chamber) { transform-box: fill-box; transform-origin: center bottom; animation: chamber-breathe 3.6s ease-in-out infinite; }
  :global(.anim-mol) { animation: mol-drift 2.8s ease-in-out infinite; }
  :global(.mol-2), :global(.mol-4) { animation-delay: -1.4s; }
  :global(.anim-heat) { animation: heat-pulse 2.2s ease-in-out infinite; }
  :global(.sys-sticker:hover .anim-piston),
  :global(.sys-sticker:hover .anim-chamber) { animation-duration: 1.4s; }
  :global(.sys-sticker:hover .anim-mol) { animation-duration: 1.1s; }

  :global(.anim-vc-body) { transform-box: fill-box; transform-origin: center; animation: vc-pulse 3.2s ease-in-out infinite; }
  :global(.anim-flow),
  :global(.anim-inner-flow) { stroke-dasharray: 8 6; animation: flow-dash 2s linear infinite; }
  :global(.anim-vc-dot) { animation: vc-dot-move 2.4s linear infinite; }
  :global(.dot-2) { animation-delay: -0.8s; }
  :global(.dot-3) { animation-delay: -1.6s; }
  :global(.anim-rotor) { transform-box: fill-box; transform-origin: center; animation: rotor-spin 4.8s linear infinite; }
  :global(.sys-sticker:hover .anim-flow),
  :global(.sys-sticker:hover .anim-inner-flow) { animation-duration: 0.75s; }
  :global(.sys-sticker:hover .anim-vc-dot) { animation-duration: 1.05s; }
  :global(.sys-sticker:hover .anim-rotor) { animation-duration: 1.4s; }
  :global(.sys-sticker:hover .anim-vc-body) { animation-duration: 1.1s; }

  :global(.anim-iso-mol) { animation: iso-bounce 2.6s ease-in-out infinite; }
  :global(.iso-2) { animation-delay: -0.9s; }
  :global(.iso-3) { animation-delay: -1.7s; }
  :global(.sys-sticker:hover .anim-iso-mol) { animation-duration: 1.2s; }
  :global(.sys-sticker:hover .anim-wall) { animation: wall-pulse 1.6s ease-in-out infinite; }

  @keyframes piston-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8.5px); } }
  @keyframes chamber-breathe { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.13); } }
  @keyframes mol-drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(4px, -3px); } }
  @keyframes heat-pulse { 0%, 100% { opacity: 0.78; transform: translateX(0); } 50% { opacity: 1; transform: translateX(3px); } }
  @keyframes vc-pulse { 0%, 100% { opacity: 0.45; transform: scale(1); } 50% { opacity: 0.85; transform: scale(1.03); } }
  @keyframes vc-dot-move {
    0% { transform: translate(0, 0); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translate(82px, 0); opacity: 0; }
  }
  @keyframes iso-bounce {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-6px, 5px); }
  }
  @keyframes flow-dash { from { stroke-dashoffset: 28; } to { stroke-dashoffset: 0; } }
  @keyframes rotor-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes wall-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.anim-piston),
    :global(.anim-chamber),
    :global(.anim-mol),
    :global(.anim-heat),
    :global(.anim-vc-body),
    :global(.anim-flow),
    :global(.anim-inner-flow),
    :global(.anim-vc-dot),
    :global(.anim-rotor),
    :global(.anim-iso-mol),
    :global(.anim-wall) { animation: none !important; }
  }

  /* ---------- Handwritten sheet ("Folha Manuscrita") ---------- */
  :global(.handwritten-sheet) {
    position: relative;
    padding: 14px 18px 16px 46px;
    border-radius: 10px;
    border: 1.5px solid #b7cdec;
    background-color: #fcfdff;
    background-image:
      linear-gradient(90deg, transparent 32px, rgba(255, 122, 89, 0.42) 32px, rgba(255, 122, 89, 0.42) 34px, transparent 34px),
      repeating-linear-gradient(to bottom, transparent 0, transparent 31px, #dbe7f6 31px, #dbe7f6 32px);
    box-shadow: 0 0 0 2px #ff7a59, 0 12px 24px -14px rgba(11, 45, 107, 0.45);
  }
  :global(.handwritten-sheet::before) {
    content: '';
    position: absolute;
    top: -0.7rem;
    right: 1rem;
    width: 4.2rem;
    height: 1.4rem;
    background: linear-gradient(180deg, rgba(236, 224, 186, 0.96), rgba(214, 198, 152, 0.88));
    transform: rotate(16deg);
    box-shadow: 0 2px 5px rgba(11, 45, 107, 0.22);
    -webkit-mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
    mask:
      linear-gradient(#000 0 0) center / calc(100% - 8px) 100% no-repeat,
      conic-gradient(from 45deg at left, #000 90deg, #0000 0) left / 4px 6px repeat-y,
      conic-gradient(from -135deg at right, #000 90deg, #0000 0) right / 4px 6px repeat-y;
  }
  .deck-stage :global(.handwritten-sheet::before) {
    top: -0.9cqw;
    right: 0.9cqw;
    width: 5.8cqw;
    height: 1.9cqw;
  }
  :global(.hw-margin-head) { margin: 0 0 10px; font-size: 0.72rem; color: #4d5b7c; text-transform: uppercase; letter-spacing: 0.08em; }
  :global(.hw-para) { margin-bottom: 14px; }
  :global(.handwritten-sheet .hw-para p) {
    margin: 0 0 6px;
    font-family: var(--hand);
    font-size: 1.18rem;
    line-height: 32px;
    color: #16377a;
  }
  :global(.hw-lead) { font-family: var(--hand-title); font-size: 1.35rem; color: #b42323; }
  :global(.handwritten-sheet .eq) {
    background: rgba(255, 255, 255, 0.78);
    border-color: #b7cdec;
    color: #16377a;
  }

  /* progressive reveal */
  .deck-stage :global(.frag:not(.shown)) { display: none; }
  .deck-stage :global(.frag.shown) { animation: fragment-in 0.3s var(--ease-out); }
  @keyframes fragment-in { from { opacity: 0; transform: translateY(0.6cqw); } }
  @media (prefers-reduced-motion: reduce) { .deck-stage :global(.slide.on), .deck-stage :global(.frag.shown) { animation: none; } }

  .deck-bar { display: flex; align-items: center; gap: 8px; }
  .db { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--slide-coral); background: var(--ink); color: #fff; font: 700 1.1rem/1 var(--sans); cursor: pointer; }
  .db :global(svg) { width: 20px; height: 20px; display: block; margin: auto; }
  .db:disabled { opacity: 0.35; cursor: default; }
  .db-count { font-size: 0.85rem; min-width: 64px; text-align: center; }
  .db-prog { flex: 1; height: 6px; border-radius: 99px; background: var(--plate); overflow: hidden; }
  .db-prog i { display: block; height: 100%; transform: scaleX(var(--progress, 0)); transform-origin: left; background: var(--slide-coral); }

  /* ---------- interactive simulators (cycleSim) in organic tactile frame ---------- */
  :global(.cycle-sim) {
    background: #fff;
    border: 2px solid #0b2d6b;
    border-radius: 16px 10px 16px 10px / 10px 16px 10px 16px;
    box-shadow: 4px 4px 0 #ff7a59;
    padding: 16px;
    display: grid;
    gap: 12px;
  }
  :global(.sim-head) { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  :global(.sim-badge) { display: inline-block; font-size: 0.68rem; letter-spacing: 0.1em; padding: 3px 8px; border-radius: 99px; background: #ffd2c6; color: #0b2d6b; font-weight: 700; }
  :global(.sim-head h4) { margin: 4px 0 2px; font: 600 1.08rem/1.2 var(--sans); color: #0b2d6b; }
  :global(.sim-sub) { margin: 0; font-size: 0.86rem; color: #4d5b7c; }
  :global(.sim-actions) { display: flex; gap: 8px; flex-wrap: wrap; }
  :global(.sim-actions .act) { font-size: 0.82rem; padding: 0.42em 0.8em; }
  :global(.sim-modes) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.sim-mode-btn) {
    border: 1.5px solid #0b2d6b;
    background: #f8fafd;
    color: #0b2d6b;
    padding: 4px 12px;
    border-radius: 180px 10px 160px 10px / 10px 160px 10px 180px;
    font: 600 0.82rem/1.2 var(--sans);
    cursor: pointer;
  }
  :global(.sim-mode-btn.active) { background: #0b2d6b; color: #fff; border-color: #ff7a59; }
  :global(.sim-grid) { display: grid; grid-template-columns: 1.25fr 0.95fr; gap: 14px; align-items: center; }
  :global(.sim-svg-box svg) { width: 100%; height: auto; display: block; background: #f8fafd; border-radius: 8px; border: 1px solid #dbe7f6; }
  :global(.sim-ctrl-box) { display: grid; gap: 10px; }
  :global(.sim-sliders) { display: grid; gap: 8px; }
  :global(.sim-param) { display: grid; gap: 2px; font-size: 0.84rem; color: #0b2d6b; }
  :global(.sim-param span) { display: flex; justify-content: space-between; gap: 8px; }
  :global(.sim-param input[type='range']) { width: 100%; accent-color: #ff7a59; margin: 0; cursor: pointer; }
  :global(.sim-kpis) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; margin: 0; }
  :global(.sim-kpis div) { background: #f1f5fc; border-radius: 8px; padding: 7px 9px; border: 1px solid #dbe7f6; }
  :global(.sim-kpis div.accent) { background: #0b2d6b; color: #fff; border-color: #0b2d6b; }
  :global(.sim-kpis dt) { font-size: 0.78rem; opacity: 0.9; }
  :global(.sim-kpis dd) { margin: 2px 0 0; font: 700 0.96rem/1.1 var(--sans); font-variant-numeric: tabular-nums; }
  :global(.sim-insight) { margin: 0; padding: 7px 10px; border-left: 3px solid #ff7a59; background: #fff4f1; font-size: 0.88rem; color: #0b2d6b; }

  .deck-stage :global(.cycle-sim) { padding: 1.05cqw 1.35cqw; gap: 0.7cqw; }
  .deck-stage :global(.sim-badge) { font-size: 0.95cqw; padding: 0.2cqw 0.65cqw; }
  .deck-stage :global(.sim-head h4) { font-size: 1.65cqw; margin: 0.25cqw 0 0.1cqw; }
  .deck-stage :global(.sim-sub) { font-size: 1.2cqw; }
  .deck-stage :global(.sim-actions .act) { font-size: 1.15cqw; padding: 0.35cqw 0.85cqw; }
  .deck-stage :global(.sim-mode-btn) { font-size: 1.15cqw; padding: 0.3cqw 0.9cqw; }
  .deck-stage :global(.sim-grid) { gap: 1.3cqw; }
  .deck-stage :global(.sim-svg-box svg) { max-height: 23.5cqw; }
  .deck-stage :global(.sim-param) { font-size: 1.22cqw; }
  .deck-stage :global(.sim-kpis) { gap: 0.55cqw; }
  .deck-stage :global(.sim-kpis div) { padding: 0.5cqw 0.75cqw; }
  .deck-stage :global(.sim-kpis dt) { font-size: 1.1cqw; }
  .deck-stage :global(.sim-kpis dd) { font-size: 1.4cqw; }
  .deck-stage :global(.sim-insight) { font-size: 1.2cqw; padding: 0.5cqw 0.9cqw; }

  /* ---------- dynamic parametric exercises (Left data/controls + Right handwritten solution) ---------- */
  :global(.dyn-ex) {
    background: #fff;
    border: 2px solid #0b2d6b;
    border-radius: 16px 10px 16px 10px / 10px 16px 10px 16px;
    box-shadow: 4px 4px 0 #0b2d6b;
    padding: 16px;
  }
  :global(.dyn-split) { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 18px; align-items: stretch; }
  :global(.dyn-left) { display: grid; gap: 10px; align-content: start; }
  :global(.dyn-badge) { display: inline-block; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 99px; background: #0b2d6b; color: #fff; }
  :global(.dyn-head h4) { margin: 5px 0 0; font: 600 1.06rem/1.2 var(--sans); color: #0b2d6b; }
  :global(.dyn-actions) { display: flex; gap: 8px; flex-wrap: wrap; }

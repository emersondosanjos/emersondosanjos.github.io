  .handout :global(.d-check-list input) { margin-top: 5px; accent-color: #ff7a59; width: 16px; height: 16px; flex: none; }

  @media print {
    :global(body > *:not(main)), :global(.ph), .teaching-author, .gate, #cat, .deck, .room-bar { display: none !important; }
    .teach { padding: 0 !important; background: #fff !important; }
    #lesson { display: block !important; }
    :global(body.print-disserte) #lesson { display: none !important; }
    :global(body.print-disserte) #disserte-panel { display: block !important; }
    .handout :global(.sim-actions), .handout :global(.sim-modes), .handout :global(.sim-sliders), .handout :global(.dyn-actions), .handout :global(.dyn-params), .handout :global(.dyn-step-bar), .handout :global(.ai-copy-btn), .handout :global(.wb-clear), .handout :global(.wb-status) { display: none !important; }
    .handout :global(.wb-input) { display: none !important; }
    .handout :global(.wb-paper.has-text .wb-print-mirror) {
      display: block !important;
      white-space: pre-wrap;
      padding: 4px 6px;
      color: #16377a;
      font-family: var(--hand);
      font-size: 1.15rem;
      line-height: 32px;
    }
    .handout :global(.wb-paper:not(.has-text) .wb-print-lines) { display: block !important; }
    .handout :global(.wb-line) { display: block; height: 32px; border-bottom: 1px solid #b7cdec; }
    .handout :global(.brush) { background: #0b2d6b !important; color: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .handout :global(.l-fig), .handout :global(.eq), .handout :global(.ex), .handout :global(.d-step), .handout :global(.write-box), .handout :global(.formula-sheet), .handout :global(.l-callout), .handout :global(.hw-para) { break-inside: avoid; }
  }
</style>

<script>
  import { experimentFor, type Experiment } from '../teaching/experiments';
  import { hydrateCycleSims, hydrateDynamicExercises } from '../teaching/interactive';

  /* encrypted bundle produced locally by `npm run teaching` (scripts/build-teaching.ts) */
  let V: any = null;
  const vaultReady = fetch('/teaching/vault.json').then((r) => r.json()).then((v) => (V = v));
  const L = JSON.parse(document.getElementById('teach-i18n')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const gate = $('gate') as HTMLFormElement, cat = $('cat'), room = $('room');
  const msg = gate.querySelector<HTMLElement>('.g-msg')!, go = gate.querySelector<HTMLButtonElement>('.g-go')!;
  const enc = new TextEncoder();
  const unb64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
  const b64 = (a: ArrayBuffer) => btoa(String.fromCharCode(...new Uint8Array(a)));
  const SK = 'eba-teach-key';
  const COURSE_SK = 'eba-teach-course';
  let key: CryptoKey | null = null;

  async function unwrap(user: string, pass: string) {
    await vaultReady;
    const u = user.trim().toLowerCase();
    const h = new Uint8Array(await crypto.subtle.digest('SHA-256', enc.encode(u)));
    const id = [...h].map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, 16);
    const e = V.keyring[id]; if (!e) throw new Error('user');
    const base = await crypto.subtle.importKey('raw', enc.encode(`${u}:${pass}`), 'PBKDF2', false, ['deriveKey']);
    const kek = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: unb64(e.salt), iterations: V.iter, hash: 'SHA-256' }, base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
    return crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(e.iv) }, kek, unb64(e.ct));
  }
  const importCK = (raw: ArrayBuffer | Uint8Array) => crypto.subtle.importKey('raw', raw, 'AES-GCM', false, ['decrypt']);
  async function openBox(box: { iv: string; ct: string }) {
    const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(box.iv) }, key!, unb64(box.ct));
    return JSON.parse(new TextDecoder().decode(pt));
  }

  /* ---------- catalog (3 taped sticker course tabs) ---------- */
  const courseTabs = $('courseTabs');
  const coursesBox = $('courses');
  let activeCourse = 'thermo';

  function selectCourseTab(courseId: string) {
    activeCourse = courseId;
    try { sessionStorage.setItem(COURSE_SK, courseId); } catch {}
    courseTabs.querySelectorAll<HTMLButtonElement>('[data-course-tab]').forEach((tab) => {
      tab.setAttribute('aria-selected', String(tab.dataset.courseTab === courseId));
    });
    coursesBox.querySelectorAll<HTMLElement>('[data-course-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.coursePanel !== courseId;
    });
  }

  async function showCatalog() {
    await vaultReady;
    const courses = await openBox(V.catalog);
    const saved = (() => { try { return sessionStorage.getItem(COURSE_SK); } catch { return null; } })();
    const initialCourse = courses.some((c: any) => c.id === saved) ? saved! : courses[0]?.id ?? 'thermo';

    courseTabs.innerHTML = courses
      .map(
        (c: any) => `
      <button type="button" class="c-tab" role="tab" data-course-tab="${c.id}" aria-selected="${c.id === initialCourse}">
        <span>${c.title}</span>
        <span class="c-tab-count mono">${c.lessons.length}</span>
      </button>`,
      )
      .join('');

    coursesBox.innerHTML = courses
      .map(
        (c: any) => `
      <section class="course" data-course-panel="${c.id}"${c.id === initialCourse ? '' : ' hidden'}>
        <div class="course-h"><h3>${c.title}</h3><p>${c.subtitle} · ${c.lessons.length} ${L.lessons}</p></div>
        ${c.description ? `<p class="course-desc">${c.description}</p>` : ''}
        ${
          c.lessons.length
            ? `<ol class="lessons ticked">${c.lessons
                .map(
                  (l: any) => `
              <li class="les">
                <span class="les-n">${String(l.num).padStart(2, '0')}<small>${L.lessonLabel}</small></span>
                <div>
                  <div class="les-t-row">
                    <p class="les-t">${l.title}</p>
                    ${l.hasDisserte && l.hasInteractive ? `<span class="les-badge">${L.upgradedTag}</span>` : ''}
                  </div>
                  <p class="les-s">${l.summary}</p>
                  <p class="les-tp">${l.topics.map((t: string) => `<span>${t}</span>`).join('')}</p>
                </div>
                <div class="les-a">
                  <button class="act solid" data-open="${l.id}" data-mode="slides">▶ ${L.slidesBtn} · ${l.slides}</button>
                  <button class="act" data-open="${l.id}" data-mode="handout">${L.handoutBtn}</button>
                  ${l.hasDisserte ? `<button class="act" data-open="${l.id}" data-mode="disserte">${L.disserteBtn}</button>` : ''}
                </div>
              </li>`,
                )
                .join('')}</ol>`
            : `<div class="course-empty"><p>${L.comingSoon}</p></div>`
        }
      </section>`,
      )
      .join('');

    selectCourseTab(initialCourse);
    gate.hidden = true; room.hidden = true; cat.hidden = false;
  }

  courseTabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-course-tab]');
    if (b) selectCourseTab(b.dataset.courseTab!);
  });

  coursesBox.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-open]');
    if (b) openLesson(b.dataset.open!, b.dataset.mode as 'slides' | 'handout' | 'disserte');
  });

  /* ---------- lesson room & modes ---------- */
  const stage = $('stage'), lesson = $('lesson'), dissertePanel = $('disserte-panel'), deck = $('deck');
  const printBtn = $('print');
  const modeTabs = $('modeTabs');
  const fullButton = $('full');
  const exitPresentation = $('exit-presentation');
  const presentationHead = $('presentation-head');
  const presentationTitle = $('presentation-title');
  const blockedInPresentation = [...document.querySelectorAll<HTMLElement>('.top, .foot, .skip, .room-bar')];
  const handset = matchMedia('(max-width: 960px) and (pointer: coarse), (max-width: 640px)');
  let nativePresentation = false;
  let lessonRequest = 0;

  let slides: HTMLElement[] = [], cur = 0, frags: HTMLElement[] = [], fi = 0;
  let lessonNum = 0;
  let currentCourseId = 'thermo';
  let currentHasInteractive = false;
  let currentMode: 'slides' | 'handout' | 'disserte' = 'slides';

  function setPresentation(active: boolean) {
    deck.classList.toggle('presenting', active);
    presentationHead.hidden = !active;
    deck.setAttribute('aria-labelledby', active ? 'presentation-title' : 'roomTitle');
    blockedInPresentation.forEach((element) => { element.inert = active; });
    if (active) {
      deck.scrollTop = 0;
      exitPresentation.focus({ preventScroll: true });
    }
  }

  async function enterPresentation() {
    setPresentation(true);
    if (document.fullscreenEnabled && deck.requestFullscreen) {
      try {
        await deck.requestFullscreen();
        if (!deck.classList.contains('presenting') && document.fullscreenElement === deck) await document.exitFullscreen();
      } catch {
        // Layout fills the viewport when native fullscreen is unavailable.
      }
    }
  }

  function leavePresentation(restoreFocus = true) {
    setPresentation(false);
    if (document.fullscreenElement === deck) void document.exitFullscreen().catch(() => {});
    if (restoreFocus && !deck.hidden) fullButton.focus({ preventScroll: true });
  }

  document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement === deck) nativePresentation = true;
    else if (nativePresentation) {
      nativePresentation = false;
      if (deck.classList.contains('presenting')) leavePresentation();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !nativePresentation && deck.classList.contains('presenting')) {
      event.preventDefault();
      leavePresentation();
    }
  });
  fullButton.addEventListener('click', enterPresentation);
  exitPresentation.addEventListener('click', () => leavePresentation());

  function setMode(mode: 'slides' | 'handout' | 'disserte') {
    currentMode = mode;
    if (mode !== 'slides' && deck.classList.contains('presenting')) leavePresentation(false);
    deck.hidden = mode !== 'slides';
    lesson.hidden = mode !== 'handout';
    dissertePanel.hidden = mode !== 'disserte';
    modeTabs.querySelectorAll<HTMLButtonElement>('[data-mode-tab]').forEach((tab) => {
      tab.setAttribute('aria-selected', String(tab.dataset.modeTab === mode));
    });
    printBtn.textContent = mode === 'disserte' ? L.printDisserte : L.printHandout;
    document.body.classList.toggle('print-disserte', mode === 'disserte' && !room.hidden);
    if (mode === 'slides' && slides.length) {
      show(cur);
      if (!deck.classList.contains('presenting')) deck.focus({ preventScroll: true });
    }
  }

  modeTabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mode-tab]');
    if (b) setMode(b.dataset.modeTab as 'slides' | 'handout' | 'disserte');
  });

  function wireAiCopy(scope: HTMLElement) {
    scope.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const pre = btn.closest('.ai-lab')?.querySelector('.ai-prompt-text');
        const text = pre?.textContent ?? '';
        if (!text) return;
        const orig = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = L.copyDone;
        } catch {
          btn.textContent = 'OK';
        }
        setTimeout(() => { btn.textContent = orig; }, 1800);
      });
    });
  }

  function wireWriteBoxes(scope: HTMLElement) {
    const boxes = [...scope.querySelectorAll<HTMLElement>('[data-write-id]')];
    const syncId = (id: string, val: string, sourceEl?: HTMLTextAreaElement) => {
      try {
        if (val.trim()) localStorage.setItem(`eba-wb-${id}`, val);
        else localStorage.removeItem(`eba-wb-${id}`);
      } catch {}
      boxes.forEach((box) => {
        if (box.dataset.writeId !== id) return;
        const ta = box.querySelector<HTMLTextAreaElement>('.wb-input')!;
        const paper = box.querySelector<HTMLElement>('.wb-paper')!;
        const mirror = box.querySelector<HTMLElement>('.wb-print-mirror')!;
        const status = box.querySelector<HTMLElement>('[data-wb-status]')!;
        if (ta !== sourceEl) ta.value = val;
        mirror.textContent = val;
        paper.classList.toggle('has-text', val.trim().length > 0);
        status.textContent = val.trim().length > 0 ? L.savedLocal : L.localNote;
      });
    };

    boxes.forEach((box) => {
      const id = box.dataset.writeId!;
      const ta = box.querySelector<HTMLTextAreaElement>('.wb-input')!;
      const clr = box.querySelector<HTMLButtonElement>('[data-wb-clear]')!;
      let initial = '';
      try { initial = localStorage.getItem(`eba-wb-${id}`) ?? ''; } catch {}
      if (initial) syncId(id, initial);

      ta.addEventListener('input', () => syncId(id, ta.value, ta));
      clr.addEventListener('click', () => {
        syncId(id, '');
        const status = box.querySelector<HTMLElement>('[data-wb-status]');
        if (status) status.textContent = L.clearedLocal;
      });
    });

    scope.querySelectorAll<HTMLInputElement>('.d-check[data-check-id]').forEach((cb) => {
      const cid = `eba-chk-${cb.dataset.checkId!}`;
      try { cb.checked = localStorage.getItem(cid) === '1'; } catch {}
      cb.addEventListener('change', () => {
        scope.querySelectorAll<HTMLInputElement>(`.d-check[data-check-id="${cb.dataset.checkId}"]`).forEach((other) => {
          other.checked = cb.checked;
        });
        try { localStorage.setItem(cid, cb.checked ? '1' : '0'); } catch {}
      });
    });
  }

  async function openLesson(id: string, mode: 'slides' | 'handout' | 'disserte') {
    const request = ++lessonRequest;
    $('roomTitle').textContent = presentationTitle.textContent = L.loading;
    cat.hidden = true;
    room.hidden = false;
    stage.innerHTML = '';
    lesson.innerHTML = '';
    dissertePanel.innerHTML = '';
    setMode(mode);
    if (mode === 'slides' && handset.matches) void enterPresentation();

    let data: any;
    try {
      const response = await fetch(`/teaching/data/${id}.json`);
      if (!response.ok) throw new Error('Could not fetch lesson');
      data = await openBox(await response.json());
    } catch {
      if (request !== lessonRequest) return;
      deck.hidden = true;
      leavePresentation(false);
      $('roomTitle').textContent = L.lessonError;
      return;
    }
    if (request !== lessonRequest) return;

    currentCourseId = data.courseId || 'thermo';
    currentHasInteractive = Boolean(data.hasInteractive);
    lessonNum = data.num;
    cur = 0;

    $('roomTitle').textContent = presentationTitle.textContent = `${data.courseTitle ? `${data.courseTitle} · ` : ''}${L.lessonLabel} ${String(data.num).padStart(2, '0')} · ${data.title}`;
    stage.innerHTML = `<div class="deck-slides">${data.slides.join('')}</div>`;
    lesson.innerHTML = data.handout;

    if (data.disserteHtml) {
      dissertePanel.innerHTML = data.disserteHtml;
      const article = lesson.querySelector('.lesson') ?? lesson;
      if (!article.querySelector('.disserte-card')) {
        const sec = document.createElement('section');
        sec.className = 'disserte-in-handout';
        sec.id = 'disserte-section';
        sec.innerHTML = data.disserteHtml;
        article.appendChild(sec);
      }
    } else {
      dissertePanel.innerHTML = `<div class="course-empty"><p>${L.disserteMissing}</p></div>`;
    }

    slides = [...stage.querySelectorAll<HTMLElement>('.slide')];
    stage.querySelectorAll('.s-fig').forEach((figure) => figure.classList.add('taped'));
    stage.querySelectorAll('.cover .s-sub').forEach((name) => {
      name.textContent = 'Emerson Barbosa dos Anjos';
      if (!name.nextElementSibling?.classList.contains('s-author-role')) {
        const degree = document.createElement('p');
        degree.className = 's-author-role';
        degree.textContent = 'Doutor em Engenharia Mecânica · COPPE/UFRJ';
        name.after(degree);
      }
    });

    $('tot').textContent = String(slides.length);
    if (!deck.classList.contains('presenting')) window.scrollTo({ top: room.getBoundingClientRect().top + scrollY - 90 });

    wireCalculator(stage);
    hydrateCycleSims(stage);
    hydrateCycleSims(lesson);
    hydrateDynamicExercises(stage);
    hydrateDynamicExercises(lesson);
    wireAiCopy(stage);
    wireAiCopy(lesson);
    wireWriteBoxes(room);

    setMode(mode);
  }

  function show(i: number, atEnd = false) {
    if (!slides.length) return;
    cur = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, k) => s.classList.toggle('on', k === cur));
    frags = [...slides[cur].querySelectorAll<HTMLElement>('.frag')];
    fi = atEnd ? frags.length : 0;
    frags.forEach((f, k) => f.classList.toggle('shown', k < fi));
    $('cur').textContent = String(cur + 1);
    $('prog').style.setProperty('--progress', String((cur + 1) / slides.length));
    const slide = slides[cur];
    if (
      currentCourseId === 'thermo' &&
      !currentHasInteractive &&
      !slide.matches('.cover, .section, .sim, .dyn, .ai') &&
      !slide.querySelector('.slide-experiment, [data-calc], [data-cycle-sim], [data-dyn-ex], .ai-lab')
    ) {
      const title = slide.querySelector('h1,h2')?.textContent ?? '';
      renderExperiment(slide, experimentFor(lessonNum, title));
    }
    slide.scrollTop = 0;
    updateNavigation();
  }
  function updateNavigation() {
    ($('prev') as HTMLButtonElement).disabled = cur === 0 && fi === 0;
    ($('next') as HTMLButtonElement).disabled = cur === slides.length - 1 && fi === frags.length;
  }
  function next() {
    if (fi < frags.length) frags[fi++].classList.add('shown');
    else if (cur < slides.length - 1) show(cur + 1);
    updateNavigation();
  }
  function prev() {
    if (fi > 0) frags[--fi].classList.remove('shown');
    else if (cur > 0) show(cur - 1, true);
    updateNavigation();
  }
  $('next').addEventListener('click', next);
  $('prev').addEventListener('click', prev);
  $('deck').addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input,button,a,select,textarea,summary')) return;
    if (['ArrowRight', 'PageDown', ' ', 'Enter'].includes(e.key)) { e.preventDefault(); next(); }
    if (['ArrowLeft', 'PageUp', 'Backspace'].includes(e.key)) { e.preventDefault(); prev(); }
    if (e.key === 'Home') show(0);
    if (e.key === 'End') show(slides.length - 1, true);
    if (e.key.toLowerCase() === 'f') {
      if (deck.classList.contains('presenting')) leavePresentation();
      else void enterPresentation();
    }
  });
  let swipeStart: { x: number; y: number } | null = null;
  stage.addEventListener('touchstart', (event) => {
    const interactive = (event.target as Element).closest('[data-cycle-sim], [data-dyn-ex], .ai-lab, input, button, a, label, summary, .eq');
    swipeStart = event.touches.length === 1 && !interactive
      ? { x: event.touches[0].clientX, y: event.touches[0].clientY }
      : null;
  }, { passive: true });
  stage.addEventListener('touchend', (event) => {
    if (!swipeStart) return;
    const dx = event.changedTouches[0].clientX - swipeStart.x;
    const dy = event.changedTouches[0].clientY - swipeStart.y;
    swipeStart = null;
    if (Math.abs(dx) > Math.max(50, 1.4 * Math.abs(dy))) (dx < 0 ? next : prev)();
  });
  stage.addEventListener('touchcancel', () => { swipeStart = null; });

  printBtn.addEventListener('click', () => {
    if (currentMode === 'disserte') {
      document.body.classList.add('print-disserte');
      window.print();
    } else {
      const was = lesson.hidden;
      document.body.classList.remove('print-disserte');
      lesson.hidden = false;
      window.print();
      lesson.hidden = was;
    }
  });
  $('back').addEventListener('click', () => {
    lessonRequest++;
    leavePresentation(false);
    document.body.classList.remove('print-disserte');
    stage.innerHTML = '';
    lesson.innerHTML = '';
    dissertePanel.innerHTML = '';
    room.hidden = true;
    cat.hidden = false;
    selectCourseTab(activeCourse);
  });

  /* ---------- sign-in / session ---------- */
  gate.querySelector('.g-eye')!.addEventListener('click', (e) => {
    const b = e.currentTarget as HTMLButtonElement, i = gate.querySelector<HTMLInputElement>('input[name=p]')!;
    const on = i.type === 'password'; i.type = on ? 'text' : 'password'; b.setAttribute('aria-pressed', String(on));
  });
  gate.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(gate);
    msg.textContent = ''; go.disabled = true; go.textContent = L.unlocking;
    try {
      const raw = await unwrap(String(fd.get('u')), String(fd.get('p')));
      key = await importCK(raw);
      try { sessionStorage.setItem(SK, b64(raw)); } catch {}
      await showCatalog();
    } catch {
      msg.textContent = L.wrong; gate.classList.remove('shake'); void gate.offsetWidth; gate.classList.add('shake');
    } finally { go.disabled = false; go.textContent = L.enter; }
  });
  document.querySelectorAll('[data-logout]').forEach((b) => b.addEventListener('click', () => {
    try { sessionStorage.removeItem(SK); } catch {}
    document.body.classList.remove('print-disserte');
    key = null; coursesBox.innerHTML = ''; courseTabs.innerHTML = ''; cat.hidden = true; room.hidden = true; gate.hidden = false; gate.reset();
  }));
  (async () => {
    try {
      const s = sessionStorage.getItem(SK);
      if (s) { key = await importCK(unb64(s)); await showCatalog(); }
    } catch { try { sessionStorage.removeItem(SK); } catch {} }
  })();

  function renderExperiment(slide: HTMLElement, model: Experiment) {
    const panel = document.createElement('details');
    panel.className = 'slide-experiment';
    panel.lang = 'pt-BR';
    const initial = model.parameters.map((parameter) => parameter.initial);
    const values = initial.slice();
    const formats = [0, 1, 2, 3, 4].map((maximumFractionDigits) => new Intl.NumberFormat('pt-BR', { maximumFractionDigits }));
    const format = (quantity: number, digits = 2) => formats[digits].format(quantity);
    const withUnit = (quantity: number, unit: string, digits = 2) => [format(quantity, digits), unit].filter(Boolean).join(' ');

    panel.innerHTML = `<summary><span class="experiment-indicator" aria-hidden="true">+</span> Testar no slide</summary>
      <div class="experiment-content"><h3>${model.title}</h3>
      <p class="experiment-question">${model.prompt}</p>
      <p class="experiment-formula">${model.formula}</p>
      <div class="experiment-controls">${model.parameters.map((parameter, index) => `
        <label class="experiment-param">
          <span>${parameter.label}<output></output></span>
          <input type="range" min="${parameter.min}" max="${parameter.max}" step="${parameter.step}"
            value="${values[index]}" aria-label="${parameter.label}${parameter.unit ? ` (${parameter.unit})` : ''}">
        </label>`).join('')}</div>
      <dl aria-live="polite"></dl>
      <button type="button" class="article-link">Restaurar valores</button></div>`;
    (slide.querySelector('.s-body') ?? slide).append(panel);
    panel.addEventListener('toggle', () => {
      if (!panel.open) return;
      const overflow = panel.getBoundingClientRect().bottom - slide.getBoundingClientRect().bottom;
      if (overflow > 0) slide.scrollTop += Math.ceil(overflow) + 12;
    });

    const inputs = [...panel.querySelectorAll<HTMLInputElement>('input')];
    const outputs = [...panel.querySelectorAll<HTMLOutputElement>('output')];
    const results = panel.querySelector('dl')!;
    function update() {
      model.parameters.forEach((parameter, index) => {
        outputs[index].textContent = withUnit(values[index], parameter.unit);
        inputs[index].setAttribute('aria-valuetext', outputs[index].textContent);
      });
      results.innerHTML = model.calculate(values).map(({ label, unit, value, decimals }) =>
        `<div><dt>${label}</dt><dd>${withUnit(value, unit, decimals)}</dd></div>`).join('');
    }
    inputs.forEach((input, index) => input.addEventListener('input', () => {
      values[index] = input.valueAsNumber;
      update();
    }));
    panel.querySelector('button')!.addEventListener('click', () => {
      inputs.forEach((input, index) => {
        values[index] = initial[index];
        input.value = String(values[index]);
      });
      update();
    });
    update();
  }

  /* interactive electrolyzer calculator used inside some slides */
  function wireCalculator(scope: HTMLElement) {
    scope.querySelectorAll<HTMLElement>('[data-calc="cell"]').forEach((box) => {
      const input = box.querySelector<HTMLInputElement>('input')!;
      const out = (k: string) => box.querySelector<HTMLElement>(`[data-out="${k}"]`);
      const F = 96485, dH = 285.8, fmt = (x: number, d = 1) => x.toFixed(d).replace('.', ',').replace('-', '−');
      const upd = () => {
        const U = Number(input.value), W = (2 * F * U) / 1000, Q = -W + dH, tn = (dH * 1000) / (2 * F);
        out('U') && (out('U')!.textContent = fmt(U, 2)); out('W') && (out('W')!.textContent = fmt(W));
        out('Q') && (out('Q')!.textContent = fmt(Q)); out('eta') && (out('eta')!.textContent = fmt((dH / W) * 100));
        out('msg') && (out('msg')!.textContent = Math.abs(U - tn) < 0.01 ? 'Tensão termoneutra: Q = 0.' : U > tn ? `Acima de ${fmt(tn, 2)} V: a célula rejeita calor.` : `Abaixo de ${fmt(tn, 2)} V: a célula precisa receber calor.`);
      };
      input.addEventListener('input', upd); upd();
    });
  }
</script>
